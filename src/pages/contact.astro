---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact Us - AutoDeal">
  <!-- Banner -->
  <section class="bg-gradient-to-br from-[var(--color-dark)] to-gray-900 py-12 lg:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="breadcrumb flex items-center gap-2 text-sm text-gray-400 mb-4">
        <a href="/" class="hover:text-[var(--color-primary)] transition-colors">Home</a>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        <span class="text-white">Contact</span>
      </nav>
      <h1 class="text-3xl lg:text-4xl font-bold text-white font-[family-name:var(--font-heading)]">Contact Us</h1>
      <p class="text-gray-400 mt-2 max-w-xl">Have a question or need a quote? We'd love to hear from you.</p>
    </div>
  </section>

  <!-- Contact Form -->
  <section class="py-16 lg:py-20">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-5 gap-10">
        <!-- Form -->
        <div class="md:col-span-3">
          <div class="bg-white border border-gray-100 rounded-2xl p-8 shadow-sm">
            <h2 class="text-xl font-bold text-gray-900 mb-6 font-[family-name:var(--font-heading)]">Send Us a Message</h2>
            <form class="space-y-5" onsubmit="event.preventDefault()">
              <div class="grid sm:grid-cols-2 gap-5">
                <div>
                  <label class="block text-xs font-medium text-gray-500 mb-1.5 uppercase tracking-wider">Name</label>
                  <input type="text" class="w-full bg-gray-50 border border-gray-200 rounded-lg px-4 py-3 text-sm focus:ring-2 focus:ring-[var(--color-primary)]/20 focus:border-[var(--color-primary)] outline-none transition-all" placeholder="Your name" />
                </div>
                <div>
                  <label class="block text-xs font-medium text-gray-500 mb-1.5 uppercase tracking-wider">Email</label>
                  <input type="email" class="w-full bg-gray-50 border border-gray-200 rounded-lg px-4 py-3 text-sm focus:ring-2 focus:ring-[var(--color-primary)]/20 focus:border-[var(--color-primary)] outline-none transition-all" placeholder="your@email.com" />
                </div>
              </div>
              <div class="grid sm:grid-cols-2 gap-5">
                <div>
                  <label class="block text-xs font-medium text-gray-500 mb-1.5 uppercase tracking-wider">Phone</label>
                  <input type="tel" class="w-full bg-gray-50 border border-gray-200 rounded-lg px-4 py-3 text-sm focus:ring-2 focus:ring-[var(--color-primary)]/20 focus:border-[var(--color-primary)] outline-none transition-all" placeholder="+44 ..." />
                </div>
                <div>
                  <label class="block text-xs font-medium text-gray-500 mb-1.5 uppercase tracking-wider">Subject</label>
                  <input type="text" id="subject-input" class="w-full bg-gray-50 border border-gray-200 rounded-lg px-4 py-3 text-sm focus:ring-2 focus:ring-[var(--color-primary)]/20 focus:border-[var(--color-primary)] outline-none transition-all" placeholder="How can we help?" />
                </div>
              </div>
              <div>
                <label class="block text-xs font-medium text-gray-500 mb-1.5 uppercase tracking-wider">Message</label>
                <textarea rows="5" class="w-full bg-gray-50 border border-gray-200 rounded-lg px-4 py-3 text-sm focus:ring-2 focus:ring-[var(--color-primary)]/20 focus:border-[var(--color-primary)] outline-none transition-all resize-none" placeholder="Tell us about the vehicle you're looking for..."></textarea>
              </div>
              <button type="submit" class="w-full bg-[var(--color-primary)] hover:bg-[var(--color-primary-dark)] text-white py-3.5 rounded-lg font-semibold transition-all hover:shadow-lg text-sm">
                Send Message
              </button>
            </form>
          </div>
        </div>

        <!-- Sidebar -->
        <div class="md:col-span-2 space-y-6">
          <div class="bg-gray-50 rounded-2xl p-6">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-[var(--color-primary)]/10 rounded-xl flex items-center justify-center shrink-0">
                <svg class="w-6 h-6 text-[var(--color-primary)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              </div>
              <div>
                <h3 class="font-semibold text-gray-900 font-[family-name:var(--font-heading)]">Address</h3>
                <p class="text-sm text-gray-500 mt-1">London, United Kingdom</p>
              </div>
            </div>
          </div>
          <div class="bg-gray-50 rounded-2xl p-6">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-[var(--color-primary)]/10 rounded-xl flex items-center justify-center shrink-0">
                <svg class="w-6 h-6 text-[var(--color-primary)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              </div>
              <div>
                <h3 class="font-semibold text-gray-900 font-[family-name:var(--font-heading)]">Phone</h3>
                <p class="text-sm text-gray-500 mt-1">+44 207 123 4567</p>
              </div>
            </div>
          </div>
          <div class="bg-gray-50 rounded-2xl p-6">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-[var(--color-primary)]/10 rounded-xl flex items-center justify-center shrink-0">
                <svg class="w-6 h-6 text-[var(--color-primary)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              </div>
              <div>
                <h3 class="font-semibold text-gray-900 font-[family-name:var(--font-heading)]">Email</h3>
                <p class="text-sm text-gray-500 mt-1">info@autodeal.com</p>
              </div>
            </div>
          </div>
          <div class="bg-gray-50 rounded-2xl p-6">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-[var(--color-primary)]/10 rounded-xl flex items-center justify-center shrink-0">
                <svg class="w-6 h-6 text-[var(--color-primary)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              </div>
              <div>
                <h3 class="font-semibold text-gray-900 font-[family-name:var(--font-heading)]">Hours</h3>
                <p class="text-sm text-gray-500 mt-1">Mon - Fri: 9:00 AM - 6:00 PM</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3-column contact info row -->
  <section class="py-12 bg-gray-50 border-t border-gray-100">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid sm:grid-cols-3 gap-6">
        <div class="text-center p-6 bg-white rounded-2xl border border-gray-100">
          <div class="w-12 h-12 bg-[var(--color-primary)]/10 rounded-full flex items-center justify-center mx-auto mb-3">
            <svg class="w-6 h-6 text-[var(--color-primary)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
          </div>
          <h3 class="font-semibold text-gray-900 font-[family-name:var(--font-heading)]">Call Us</h3>
          <p class="text-sm text-gray-500 mt-1">+44 207 123 4567</p>
        </div>
        <div class="text-center p-6 bg-white rounded-2xl border border-gray-100">
          <div class="w-12 h-12 bg-[var(--color-primary)]/10 rounded-full flex items-center justify-center mx-auto mb-3">
            <svg class="w-6 h-6 text-[var(--color-primary)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          </div>
          <h3 class="font-semibold text-gray-900 font-[family-name:var(--font-heading)]">Email Us</h3>
          <p class="text-sm text-gray-500 mt-1">info@autodeal.com</p>
        </div>
        <div class="text-center p-6 bg-white rounded-2xl border border-gray-100">
          <div class="w-12 h-12 bg-[var(--color-primary)]/10 rounded-full flex items-center justify-center mx-auto mb-3">
            <svg class="w-6 h-6 text-[var(--color-primary)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          </div>
          <h3 class="font-semibold text-gray-900 font-[family-name:var(--font-heading)]">Visit Us</h3>
          <p class="text-sm text-gray-500 mt-1">London, United Kingdom</p>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  // Pre-fill subject from URL params (e.g., from vehicle enquiry)
  const params = new URLSearchParams(window.location.search);
  const vehicle = params.get('vehicle');
  if (vehicle) {
    const subjectInput = document.getElementById('subject-input') as HTMLInputElement;
    if (subjectInput) subjectInput.value = `Enquiry about ${vehicle}`;
  }
</script>
