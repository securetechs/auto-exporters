---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const vehicles = await getCollection('vehicles');
  return vehicles.map(vehicle => ({
    params: { slug: vehicle.data.slug },
    props: { vehicle },
  }));
}

const { vehicle } = Astro.props;
const { Content } = await render(vehicle);
const { title, make, model, year, price, mileage, fuel, transmission, bodyType, color, description, images, slug } = vehicle.data;

// Get related vehicles (same make or bodyType, exclude current)
const allVehicles = await getCollection('vehicles');
const related = allVehicles
  .filter(v => v.data.slug !== slug && (v.data.make === make || v.data.bodyType === bodyType))
  .slice(0, 3);

const specs = [
  { label: 'Make', value: make, icon: 'tag' },
  { label: 'Model', value: model, icon: 'tag' },
  { label: 'Year', value: String(year), icon: 'calendar' },
  { label: 'Body Type', value: bodyType, icon: 'truck' },
  { label: 'Mileage', value: `${mileage.toLocaleString()} miles`, icon: 'speed' },
  { label: 'Fuel', value: fuel, icon: 'fuel' },
  { label: 'Transmission', value: transmission, icon: 'gear' },
  { label: 'Color', value: color || 'N/A', icon: 'palette' },
];

const hasImages = images && images.length > 0;
---

<Layout title={`${title} - AutoDeal`} description={description}>
  <!-- Breadcrumb -->
  <div class="bg-gray-50 border-b border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
      <nav class="flex items-center gap-2 text-sm text-gray-500">
        <a href="/" class="hover:text-[var(--color-primary)] transition-colors">Home</a>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        <a href="/vehicles" class="hover:text-[var(--color-primary)] transition-colors">Vehicles</a>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        <span class="text-gray-900 font-medium truncate">{title}</span>
      </nav>
    </div>
  </div>

  <section class="py-8 lg:py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="lg:grid lg:grid-cols-[1fr_380px] lg:gap-10">

        <!-- Left Column: Gallery + Details -->
        <div>
          <!-- Photo Gallery -->
          <div class="mb-8">
            {hasImages ? (
              <div>
                <!-- Main Image -->
                <div id="main-image-wrapper" class="relative aspect-[16/10] rounded-2xl overflow-hidden bg-gray-100 mb-3">
                  <img id="main-image" src={images[0]} alt={title} class="w-full h-full object-cover" />
                  {images.length > 1 && (
                    <>
                      <button id="prev-btn" class="absolute left-3 top-1/2 -translate-y-1/2 w-10 h-10 bg-white/80 backdrop-blur-sm rounded-full flex items-center justify-center text-gray-700 hover:bg-white transition-all shadow-md">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
                      </button>
                      <button id="next-btn" class="absolute right-3 top-1/2 -translate-y-1/2 w-10 h-10 bg-white/80 backdrop-blur-sm rounded-full flex items-center justify-center text-gray-700 hover:bg-white transition-all shadow-md">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                      </button>
                    </>
                  )}
                  <div class="absolute bottom-3 right-3 bg-black/50 text-white text-xs px-3 py-1 rounded-full backdrop-blur-sm">
                    <span id="img-counter">1</span> / {images.length}
                  </div>
                </div>
                <!-- Thumbnails -->
                {images.length > 1 && (
                  <div class="grid grid-cols-5 gap-2">
                    {images.slice(0, 5).map((img: string, i: number) => (
                      <button
                        class="thumb-btn aspect-[16/10] rounded-lg overflow-hidden border-2 border-transparent hover:border-[var(--color-primary)] transition-all"
                        data-index={i}
                      >
                        <img src={img} alt={`${title} photo ${i + 1}`} class="w-full h-full object-cover" />
                      </button>
                    ))}
                  </div>
                )}
              </div>
            ) : (
              <!-- Placeholder when no images -->
              <div class="aspect-[16/10] rounded-2xl overflow-hidden bg-gradient-to-br from-gray-100 to-gray-200 flex items-center justify-center">
                <div class="text-center">
                  <svg class="w-20 h-20 text-gray-300 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                  <p class="text-gray-400 text-sm mt-2">Photos coming soon</p>
                </div>
              </div>
            )}
          </div>

          <!-- Title + Price (mobile) -->
          <div class="lg:hidden mb-6">
            <h1 class="text-2xl font-bold text-gray-900 font-[family-name:var(--font-heading)]">{title}</h1>
            <div class="text-3xl font-bold text-[var(--color-primary)] mt-2 font-[family-name:var(--font-heading)]">
              ${price.toLocaleString()}
            </div>
          </div>

          <!-- Specs Grid -->
          <div class="bg-white rounded-2xl border border-gray-200 p-6 mb-8">
            <h2 class="text-lg font-semibold text-gray-900 font-[family-name:var(--font-heading)] mb-5">Specifications</h2>
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
              {specs.map(spec => (
                <div class="bg-gray-50 rounded-xl p-4 text-center">
                  <p class="text-xs text-gray-500 uppercase tracking-wider mb-1">{spec.label}</p>
                  <p class="text-sm font-semibold text-gray-900">{spec.value}</p>
                </div>
              ))}
            </div>
          </div>

          <!-- Description / Body Content -->
          <div class="bg-white rounded-2xl border border-gray-200 p-6 mb-8">
            <h2 class="text-lg font-semibold text-gray-900 font-[family-name:var(--font-heading)] mb-4">Vehicle Description</h2>
            <div class="prose prose-sm max-w-none text-gray-600 prose-headings:text-gray-900 prose-headings:font-[family-name:var(--font-heading)] prose-h2:text-base prose-h3:text-sm prose-li:marker:text-[var(--color-primary)]">
              <Content />
            </div>
          </div>
        </div>

        <!-- Right Sidebar -->
        <div>
          <div class="lg:sticky lg:top-28 space-y-6">
            <!-- Title + Price (desktop) -->
            <div class="hidden lg:block">
              <div class="flex gap-2 mb-3">
                <span class="bg-[var(--color-primary)]/10 text-[var(--color-primary)] text-xs font-semibold px-3 py-1 rounded-full">{bodyType}</span>
                <span class="bg-gray-100 text-gray-600 text-xs font-semibold px-3 py-1 rounded-full">{year}</span>
              </div>
              <h1 class="text-2xl font-bold text-gray-900 font-[family-name:var(--font-heading)]">{title}</h1>
              <div class="text-3xl font-bold text-[var(--color-primary)] mt-3 font-[family-name:var(--font-heading)]">
                ${price.toLocaleString()}
              </div>
              <p class="text-sm text-gray-500 mt-2">{description}</p>
            </div>

            <!-- Quick Specs -->
            <div class="bg-white rounded-2xl border border-gray-200 p-5">
              <h3 class="text-sm font-semibold text-gray-900 mb-4 font-[family-name:var(--font-heading)]">Quick Specs</h3>
              <div class="space-y-3">
                <div class="flex justify-between items-center py-2 border-b border-gray-100">
                  <span class="text-sm text-gray-500">Mileage</span>
                  <span class="text-sm font-semibold text-gray-900">{mileage.toLocaleString()} mi</span>
                </div>
                <div class="flex justify-between items-center py-2 border-b border-gray-100">
                  <span class="text-sm text-gray-500">Fuel Type</span>
                  <span class="text-sm font-semibold text-gray-900">{fuel}</span>
                </div>
                <div class="flex justify-between items-center py-2 border-b border-gray-100">
                  <span class="text-sm text-gray-500">Transmission</span>
                  <span class="text-sm font-semibold text-gray-900">{transmission}</span>
                </div>
                <div class="flex justify-between items-center py-2 border-b border-gray-100">
                  <span class="text-sm text-gray-500">Body Type</span>
                  <span class="text-sm font-semibold text-gray-900">{bodyType}</span>
                </div>
                <div class="flex justify-between items-center py-2">
                  <span class="text-sm text-gray-500">Color</span>
                  <span class="text-sm font-semibold text-gray-900">{color || 'N/A'}</span>
                </div>
              </div>
            </div>

            <!-- Enquiry CTA -->
            <div class="bg-gradient-to-br from-[var(--color-dark)] to-gray-900 rounded-2xl p-6 text-center">
              <h3 class="text-white font-semibold font-[family-name:var(--font-heading)] text-lg mb-2">Interested in this vehicle?</h3>
              <p class="text-gray-400 text-sm mb-5">Get a free quote including shipping to your destination.</p>
              <a href={`/contact?vehicle=${encodeURIComponent(title)}`} class="block w-full bg-[var(--color-primary)] hover:bg-[var(--color-primary-dark)] text-white py-3.5 rounded-xl font-semibold transition-all hover:shadow-lg hover:shadow-[var(--color-primary)]/25 text-sm">
                Enquire Now
              </a>
              <div class="flex items-center justify-center gap-4 mt-4 text-gray-400 text-xs">
                <span class="flex items-center gap-1">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                  Call Us
                </span>
                <span class="flex items-center gap-1">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
                  WhatsApp
                </span>
              </div>
            </div>

            <!-- Export Info -->
            <div class="bg-orange-50 border border-orange-200 rounded-2xl p-5">
              <div class="flex items-start gap-3">
                <svg class="w-6 h-6 text-[var(--color-primary)] shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                <div>
                  <h4 class="font-semibold text-gray-900 text-sm font-[family-name:var(--font-heading)]">Export Ready</h4>
                  <p class="text-xs text-gray-600 mt-1">This vehicle includes all documentation for international export: V5C logbook, purchase invoice, and export certificate.</p>
                </div>
              </div>
            </div>

            <!-- Back to Listings -->
            <a href="/vehicles" class="flex items-center gap-2 text-sm text-gray-500 hover:text-[var(--color-primary)] transition-colors font-medium">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
              Back to all vehicles
            </a>
          </div>
        </div>
      </div>

      <!-- Related Vehicles -->
      {related.length > 0 && (
        <div class="mt-16 pt-12 border-t border-gray-200">
          <h2 class="text-2xl font-bold text-gray-900 font-[family-name:var(--font-heading)] mb-8">Similar Vehicles</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {related.map(v => (
              <a href={`/vehicles/${v.data.slug}`} class="group bg-white rounded-2xl border border-gray-100 overflow-hidden hover:shadow-lg hover:border-[var(--color-primary)]/20 transition-all duration-300">
                <div class="relative aspect-[16/10] bg-gray-100 overflow-hidden">
                  {v.data.images && v.data.images.length > 0 ? (
                    <img src={v.data.images[0]} alt={v.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                  ) : (
                    <div class="absolute inset-0 flex items-center justify-center bg-gradient-to-br from-gray-100 to-gray-200">
                      <svg class="w-12 h-12 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                      </svg>
                    </div>
                  )}
                  <span class="absolute top-3 left-3 bg-[var(--color-primary)] text-white text-xs font-semibold px-3 py-1 rounded-full">{v.data.bodyType}</span>
                </div>
                <div class="p-5">
                  <h3 class="font-semibold text-gray-900 group-hover:text-[var(--color-primary)] transition-colors font-[family-name:var(--font-heading)]">{v.data.title}</h3>
                  <div class="text-xl font-bold text-[var(--color-primary)] mt-1 font-[family-name:var(--font-heading)]">${v.data.price.toLocaleString()}</div>
                  <div class="grid grid-cols-3 gap-3 mt-3 pt-3 border-t border-gray-100">
                    <span class="text-xs text-gray-500">{v.data.mileage.toLocaleString()} mi</span>
                    <span class="text-xs text-gray-500">{v.data.fuel}</span>
                    <span class="text-xs text-gray-500">{v.data.transmission}</span>
                  </div>
                </div>
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>
</Layout>

<!-- Gallery Script -->
{hasImages && images.length > 1 && (
  <script is:inline define:vars={{ images }}>
    const mainImg = document.getElementById('main-image');
    const counter = document.getElementById('img-counter');
    const prevBtn = document.getElementById('prev-btn');
    const nextBtn = document.getElementById('next-btn');
    const thumbs = document.querySelectorAll('.thumb-btn');
    let current = 0;

    function showImage(index) {
      current = index;
      mainImg.src = images[current];
      counter.textContent = String(current + 1);
      thumbs.forEach((t, i) => {
        t.classList.toggle('border-[var(--color-primary)]', i === current);
        t.classList.toggle('border-transparent', i !== current);
      });
    }

    prevBtn?.addEventListener('click', () => showImage((current - 1 + images.length) % images.length));
    nextBtn?.addEventListener('click', () => showImage((current + 1) % images.length));
    thumbs.forEach(t => t.addEventListener('click', () => showImage(Number(t.dataset.index))));
    showImage(0);
  </script>
)}
