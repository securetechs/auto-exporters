---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Blog - AutoDeal">
  <section class="bg-gradient-to-br from-[var(--color-dark)] to-gray-900 py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl font-bold text-white font-[family-name:var(--font-heading)]">Blog</h1>
      <p class="text-gray-400 mt-3">News, guides, and insights about vehicle export</p>
    </div>
  </section>

  <section class="py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-orange-50 border border-orange-200 rounded-2xl p-8 text-center">
        <p class="text-[var(--color-primary)] font-semibold font-[family-name:var(--font-heading)]">Blog Coming Soon</p>
        <p class="text-gray-500 text-sm mt-2">Articles and guides will be published here shortly.</p>
      </div>
    </div>
  </section>
</Layout>
