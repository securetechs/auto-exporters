---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const posts = allPosts
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const categories = [...new Set(posts.map(p => p.data.category))].sort();

function formatDate(date: Date): string {
  return date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
}
---

<Layout title="Blog - AutoDeal" description="Expert guides, vehicle reviews, and industry insights about vehicle export from the UK.">
  <!-- Banner with Breadcrumb -->
  <section class="bg-gradient-to-br from-[var(--color-dark)] to-gray-900 py-12 lg:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="breadcrumb flex items-center gap-2 text-sm text-gray-400 mb-4">
        <a href="/" class="hover:text-[var(--color-primary)] transition-colors">Home</a>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        <span class="text-white">Blog</span>
      </nav>
      <h1 class="text-3xl lg:text-4xl font-bold text-white font-[family-name:var(--font-heading)]">News & Guides</h1>
      <p class="text-gray-400 mt-2 max-w-xl">Expert advice, industry news, and vehicle insights to help you make informed export decisions.</p>
    </div>
  </section>

  <section class="py-10 lg:py-14">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Category Pills -->
      <div class="flex flex-wrap gap-2 mb-8">
        <button class="category-pill active bg-[var(--color-primary)] text-white text-sm font-medium px-5 py-2 rounded-full transition-all" data-category="all">
          All Posts
        </button>
        {categories.map(cat => (
          <button class="category-pill bg-gray-100 text-gray-600 hover:bg-gray-200 text-sm font-medium px-5 py-2 rounded-full transition-all" data-category={cat}>
            {cat}
          </button>
        ))}
      </div>

      <!-- Posts Grid -->
      <div id="posts-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {posts.map(post => (
          <article
            class="blog-card group bg-white rounded-2xl border border-gray-100 overflow-hidden hover:shadow-lg transition-all duration-300"
            data-category={post.data.category}
          >
            <a href={`/blog/${post.data.slug}`} class="block">
              <div class="relative aspect-[16/10] bg-gray-100 overflow-hidden">
                {post.data.image ? (
                  <img src={post.data.image} alt={post.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
                ) : (
                  <div class="absolute inset-0 flex items-center justify-center bg-gradient-to-br from-orange-50 to-orange-100">
                    <svg class="w-12 h-12 text-[var(--color-primary)]/30" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
                    </svg>
                  </div>
                )}
                <!-- Date badge overlay -->
                <div class="blog-date-badge">{formatDate(post.data.date)}</div>
              </div>
            </a>
            <div class="p-5">
              <div class="flex items-center gap-3 mb-3 text-xs text-gray-500">
                <span class="flex items-center gap-1">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                  {post.data.author}
                </span>
                <span class="bg-gray-100 text-gray-600 px-2 py-0.5 rounded text-xs">{post.data.category}</span>
              </div>
              <h2 class="font-semibold text-gray-900 group-hover:text-[var(--color-primary)] transition-colors font-[family-name:var(--font-heading)] text-lg leading-tight mb-2">
                <a href={`/blog/${post.data.slug}`}>{post.data.title}</a>
              </h2>
              <p class="text-sm text-gray-500 line-clamp-2 mb-4">{post.data.description}</p>
              <a href={`/blog/${post.data.slug}`} class="inline-flex items-center gap-1 text-sm font-semibold text-[var(--color-primary)] group-hover:gap-2 transition-all">
                Read More
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
              </a>
            </div>
          </article>
        ))}
      </div>

      <div id="no-posts" class="hidden py-16 text-center">
        <h3 class="text-lg font-semibold text-gray-900 font-[family-name:var(--font-heading)]">No posts in this category</h3>
        <p class="text-gray-500 text-sm mt-1">Try selecting a different category.</p>
      </div>

      <div class="mt-8 text-center">
        <p class="text-sm text-gray-400">Showing <span id="post-count" class="font-semibold text-gray-600">{posts.length}</span> posts</p>
      </div>
    </div>
  </section>
</Layout>

<script>
  const pills = document.querySelectorAll<HTMLButtonElement>('.category-pill');
  const cards = document.querySelectorAll<HTMLElement>('.blog-card');
  const grid = document.getElementById('posts-grid')!;
  const noPosts = document.getElementById('no-posts')!;
  const postCount = document.getElementById('post-count')!;

  function setActiveCategory(cat: string) {
    pills.forEach(pill => {
      const isActive = pill.dataset.category === cat;
      pill.classList.toggle('active', isActive);
      pill.classList.toggle('bg-[var(--color-primary)]', isActive);
      pill.classList.toggle('text-white', isActive);
      pill.classList.toggle('bg-gray-100', !isActive);
      pill.classList.toggle('text-gray-600', !isActive);
    });
    let visible = 0;
    cards.forEach(card => {
      const show = cat === 'all' || card.dataset.category === cat;
      card.style.display = show ? '' : 'none';
      if (show) visible++;
    });
    postCount.textContent = String(visible);
    noPosts.classList.toggle('hidden', visible > 0);
    grid.classList.toggle('hidden', visible === 0);
    const url = cat === 'all' ? window.location.pathname : `${window.location.pathname}?category=${encodeURIComponent(cat)}`;
    window.history.replaceState({}, '', url);
  }

  pills.forEach(pill => pill.addEventListener('click', () => setActiveCategory(pill.dataset.category || 'all')));
  const params = new URLSearchParams(window.location.search);
  setActiveCategory(params.get('category') || 'all');
</script>
