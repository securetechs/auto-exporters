---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allVehicles = await getCollection('vehicles');

// Extract unique values for filter dropdowns
const makes = [...new Set(allVehicles.map(v => v.data.make))].sort();
const models = [...new Set(allVehicles.map(v => v.data.model))].sort();
const bodyTypes = [...new Set(allVehicles.map(v => v.data.bodyType))].sort();
const years = [...new Set(allVehicles.map(v => v.data.year))].sort((a, b) => b - a);
const fuels = [...new Set(allVehicles.map(v => v.data.fuel))].sort();

// Build make->models map for dependent dropdown
const makeModelsMap: Record<string, string[]> = {};
allVehicles.forEach(v => {
  if (!makeModelsMap[v.data.make]) makeModelsMap[v.data.make] = [];
  if (!makeModelsMap[v.data.make].includes(v.data.model)) {
    makeModelsMap[v.data.make].push(v.data.model);
  }
});

// Sort vehicles by featured first, then by price desc
const vehicles = allVehicles.sort((a, b) => {
  if (a.data.featured && !b.data.featured) return -1;
  if (!a.data.featured && b.data.featured) return 1;
  return b.data.price - a.data.price;
});
---

<Layout title="Vehicles - AutoDeal" description="Browse our inventory of quality UK vehicles for export. Filter by make, model, year, price, body type and mileage.">
  <!-- Hero -->
  <section class="bg-gradient-to-br from-[var(--color-dark)] to-gray-900 py-14 lg:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="text-[var(--color-primary)] text-sm font-semibold uppercase tracking-wider">Our Inventory</span>
      <h1 class="text-3xl lg:text-4xl font-bold text-white font-[family-name:var(--font-heading)] mt-2">Browse Vehicles</h1>
      <p class="text-gray-400 mt-3 max-w-xl mx-auto">Quality UK vehicles ready for international export. Use the filters to find your perfect car.</p>
    </div>
  </section>

  <!-- Filters + Grid -->
  <section class="py-10 lg:py-14">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="lg:grid lg:grid-cols-[280px_1fr] lg:gap-8">

        <!-- Sidebar Filters -->
        <aside>
          <div class="bg-white rounded-2xl border border-gray-200 p-6 lg:sticky lg:top-28">
            <div class="flex items-center justify-between mb-5">
              <h2 class="text-lg font-semibold text-gray-900 font-[family-name:var(--font-heading)]">Filters</h2>
              <button id="clear-filters" class="text-xs text-[var(--color-primary)] hover:underline font-medium hidden">Clear All</button>
            </div>

            <form id="filter-form" class="space-y-5">
              <!-- Make -->
              <div>
                <label class="block text-xs font-medium text-gray-500 mb-1.5 uppercase tracking-wider">Make</label>
                <select name="make" class="w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-2.5 text-sm text-gray-700 focus:ring-2 focus:ring-[var(--color-primary)]/20 focus:border-[var(--color-primary)] outline-none transition-all appearance-none cursor-pointer">
                  <option value="">All Makes</option>
                  {makes.map(m => <option value={m}>{m}</option>)}
                </select>
              </div>

              <!-- Model (dependent on Make) -->
              <div>
                <label class="block text-xs font-medium text-gray-500 mb-1.5 uppercase tracking-wider">Model</label>
                <select name="model" class="w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-2.5 text-sm text-gray-700 focus:ring-2 focus:ring-[var(--color-primary)]/20 focus:border-[var(--color-primary)] outline-none transition-all appearance-none cursor-pointer">
                  <option value="">All Models</option>
                  {models.map(m => <option value={m}>{m}</option>)}
                </select>
              </div>

              <!-- Body Type -->
              <div>
                <label class="block text-xs font-medium text-gray-500 mb-1.5 uppercase tracking-wider">Body Type</label>
                <select name="body" class="w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-2.5 text-sm text-gray-700 focus:ring-2 focus:ring-[var(--color-primary)]/20 focus:border-[var(--color-primary)] outline-none transition-all appearance-none cursor-pointer">
                  <option value="">All Body Types</option>
                  {bodyTypes.map(b => <option value={b}>{b}</option>)}
                </select>
              </div>

              <!-- Year -->
              <div>
                <label class="block text-xs font-medium text-gray-500 mb-1.5 uppercase tracking-wider">Year</label>
                <select name="year" class="w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-2.5 text-sm text-gray-700 focus:ring-2 focus:ring-[var(--color-primary)]/20 focus:border-[var(--color-primary)] outline-none transition-all appearance-none cursor-pointer">
                  <option value="">All Years</option>
                  {years.map(y => <option value={y}>{y}</option>)}
                </select>
              </div>

              <!-- Price Range -->
              <div>
                <label class="block text-xs font-medium text-gray-500 mb-1.5 uppercase tracking-wider">Price Range</label>
                <select name="price" class="w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-2.5 text-sm text-gray-700 focus:ring-2 focus:ring-[var(--color-primary)]/20 focus:border-[var(--color-primary)] outline-none transition-all appearance-none cursor-pointer">
                  <option value="">Any Price</option>
                  <option value="0-30000">Under $30,000</option>
                  <option value="30000-50000">$30,000 - $50,000</option>
                  <option value="50000-75000">$50,000 - $75,000</option>
                  <option value="75000-999999">$75,000+</option>
                </select>
              </div>

              <!-- Mileage Range -->
              <div>
                <label class="block text-xs font-medium text-gray-500 mb-1.5 uppercase tracking-wider">Mileage</label>
                <select name="mileage" class="w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-2.5 text-sm text-gray-700 focus:ring-2 focus:ring-[var(--color-primary)]/20 focus:border-[var(--color-primary)] outline-none transition-all appearance-none cursor-pointer">
                  <option value="">Any Mileage</option>
                  <option value="0-5000">Under 5,000 mi</option>
                  <option value="0-10000">Under 10,000 mi</option>
                  <option value="0-20000">Under 20,000 mi</option>
                  <option value="0-50000">Under 50,000 mi</option>
                </select>
              </div>

              <!-- Fuel Type -->
              <div>
                <label class="block text-xs font-medium text-gray-500 mb-1.5 uppercase tracking-wider">Fuel Type</label>
                <select name="fuel" class="w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-2.5 text-sm text-gray-700 focus:ring-2 focus:ring-[var(--color-primary)]/20 focus:border-[var(--color-primary)] outline-none transition-all appearance-none cursor-pointer">
                  <option value="">All Fuel Types</option>
                  {fuels.map(f => <option value={f}>{f}</option>)}
                </select>
              </div>

              <!-- Mobile: Apply button -->
              <button type="button" id="mobile-apply" class="lg:hidden w-full bg-[var(--color-primary)] hover:bg-[var(--color-primary-dark)] text-white py-3 rounded-xl font-semibold transition-all text-sm">
                Apply Filters
              </button>
            </form>
          </div>
        </aside>

        <!-- Results -->
        <div>
          <!-- Results header -->
          <div class="flex items-center justify-between mb-6">
            <div>
              <p class="text-sm text-gray-500">
                Showing <span id="result-count" class="font-semibold text-gray-900">{vehicles.length}</span> vehicles
              </p>
            </div>
            <div class="flex items-center gap-3">
              <label class="text-xs text-gray-500 font-medium">Sort by</label>
              <select id="sort-select" class="bg-gray-50 border border-gray-200 rounded-lg px-3 py-2 text-sm text-gray-700 outline-none cursor-pointer">
                <option value="featured">Featured</option>
                <option value="price-low">Price: Low to High</option>
                <option value="price-high">Price: High to Low</option>
                <option value="year-new">Year: Newest</option>
                <option value="mileage-low">Mileage: Lowest</option>
              </select>
              <!-- Mobile filter toggle -->
              <button id="mobile-filter-toggle" class="lg:hidden flex items-center gap-2 bg-gray-50 border border-gray-200 rounded-lg px-3 py-2 text-sm text-gray-700">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"/></svg>
                Filters
              </button>
            </div>
          </div>

          <!-- Vehicle Grid -->
          <div id="vehicle-grid" class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-6">
            {vehicles.map(vehicle => (
              <a
                href={`/vehicles/${vehicle.data.slug}`}
                class="vehicle-card group bg-white rounded-2xl border border-gray-100 overflow-hidden hover:shadow-lg hover:border-[var(--color-primary)]/20 transition-all duration-300"
                data-make={vehicle.data.make}
                data-model={vehicle.data.model}
                data-year={vehicle.data.year}
                data-price={vehicle.data.price}
                data-mileage={vehicle.data.mileage}
                data-body={vehicle.data.bodyType}
                data-fuel={vehicle.data.fuel}
                data-featured={vehicle.data.featured}
              >
                <!-- Image -->
                <div class="relative aspect-[16/10] bg-gray-100 overflow-hidden">
                  {vehicle.data.images && vehicle.data.images.length > 0 ? (
                    <img src={vehicle.data.images[0]} alt={vehicle.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                  ) : (
                    <div class="absolute inset-0 flex items-center justify-center bg-gradient-to-br from-gray-100 to-gray-200">
                      <svg class="w-16 h-16 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                      </svg>
                    </div>
                  )}
                  <!-- Badges -->
                  <div class="absolute top-3 left-3 flex gap-2">
                    <span class="bg-[var(--color-primary)] text-white text-xs font-semibold px-3 py-1 rounded-full">
                      {vehicle.data.bodyType}
                    </span>
                    {vehicle.data.featured && (
                      <span class="bg-emerald-500 text-white text-xs font-semibold px-3 py-1 rounded-full">Featured</span>
                    )}
                  </div>
                </div>

                <!-- Content -->
                <div class="p-5">
                  <div class="flex items-start justify-between gap-2">
                    <h3 class="font-semibold text-gray-900 group-hover:text-[var(--color-primary)] transition-colors font-[family-name:var(--font-heading)] text-lg leading-tight">
                      {vehicle.data.title}
                    </h3>
                  </div>
                  <div class="text-2xl font-bold text-[var(--color-primary)] mt-2 font-[family-name:var(--font-heading)]">
                    ${vehicle.data.price.toLocaleString()}
                  </div>

                  <p class="text-sm text-gray-500 mt-2 line-clamp-2">{vehicle.data.description}</p>

                  <!-- Specs -->
                  <div class="grid grid-cols-3 gap-3 mt-4 pt-4 border-t border-gray-100">
                    <div class="flex items-center gap-1.5 text-gray-500">
                      <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                      <span class="text-xs truncate">{vehicle.data.mileage.toLocaleString()} mi</span>
                    </div>
                    <div class="flex items-center gap-1.5 text-gray-500">
                      <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 18.657A8 8 0 016.343 7.343S7 9 9 10c0-2 .5-5 2.986-7C14 5 16.09 5.777 17.656 7.343A7.975 7.975 0 0120 13a7.975 7.975 0 01-2.343 5.657z"/></svg>
                      <span class="text-xs truncate">{vehicle.data.fuel}</span>
                    </div>
                    <div class="flex items-center gap-1.5 text-gray-500">
                      <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                      <span class="text-xs truncate">{vehicle.data.transmission}</span>
                    </div>
                  </div>

                  <!-- View button -->
                  <div class="mt-4">
                    <span class="inline-flex items-center gap-1 text-sm font-semibold text-[var(--color-primary)] group-hover:gap-2 transition-all">
                      View Details
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                    </span>
                  </div>
                </div>
              </a>
            ))}
          </div>

          <!-- No results -->
          <div id="no-results" class="hidden py-16 text-center">
            <svg class="w-16 h-16 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
            <h3 class="text-lg font-semibold text-gray-900 font-[family-name:var(--font-heading)]">No vehicles found</h3>
            <p class="text-gray-500 text-sm mt-1">Try adjusting your filters or clearing them to see all vehicles.</p>
            <button id="no-results-clear" class="mt-4 text-sm text-[var(--color-primary)] font-semibold hover:underline">Clear all filters</button>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<!-- Make→Models map for dependent dropdown -->
<script is:inline define:vars={{ makeModelsMap }}>
  window.__makeModelsMap = makeModelsMap;
</script>

<script>
  const form = document.getElementById('filter-form') as HTMLFormElement;
  const grid = document.getElementById('vehicle-grid')!;
  const cards = grid.querySelectorAll<HTMLElement>('.vehicle-card');
  const resultCount = document.getElementById('result-count')!;
  const noResults = document.getElementById('no-results')!;
  const clearBtn = document.getElementById('clear-filters')!;
  const noResultsClear = document.getElementById('no-results-clear')!;
  const sortSelect = document.getElementById('sort-select') as HTMLSelectElement;
  const mobileToggle = document.getElementById('mobile-filter-toggle');
  const mobileApply = document.getElementById('mobile-apply');
  const sidebar = form.closest('aside')!;
  const makeSelect = form.querySelector('select[name="make"]') as HTMLSelectElement;
  const modelSelect = form.querySelector('select[name="model"]') as HTMLSelectElement;

  // Read URL params on load
  function getParams(): URLSearchParams {
    return new URLSearchParams(window.location.search);
  }

  // Set form values from URL
  function initFromURL() {
    const params = getParams();
    const selects = form.querySelectorAll('select');
    selects.forEach(select => {
      const val = params.get(select.name);
      if (val) select.value = val;
    });
    const sort = params.get('sort');
    if (sort) sortSelect.value = sort;
  }

  // Update URL without reload
  function updateURL() {
    const params = new URLSearchParams();
    const selects = form.querySelectorAll('select');
    selects.forEach(select => {
      if (select.value) params.set(select.name, select.value);
    });
    if (sortSelect.value && sortSelect.value !== 'featured') {
      params.set('sort', sortSelect.value);
    }
    const qs = params.toString();
    const url = qs ? `${window.location.pathname}?${qs}` : window.location.pathname;
    window.history.replaceState({}, '', url);
  }

  // Filter + sort
  function applyFilters() {
    const make = (form.querySelector('select[name="make"]') as HTMLSelectElement).value;
    const model = (form.querySelector('select[name="model"]') as HTMLSelectElement).value;
    const body = (form.querySelector('select[name="body"]') as HTMLSelectElement).value;
    const year = (form.querySelector('select[name="year"]') as HTMLSelectElement).value;
    const price = (form.querySelector('select[name="price"]') as HTMLSelectElement).value;
    const mileage = (form.querySelector('select[name="mileage"]') as HTMLSelectElement).value;
    const fuel = (form.querySelector('select[name="fuel"]') as HTMLSelectElement).value;
    const sort = sortSelect.value;

    let visible = 0;
    const cardsArray = Array.from(cards);

    cardsArray.forEach(card => {
      let show = true;

      if (make && card.dataset.make !== make) show = false;
      if (model && card.dataset.model !== model) show = false;
      if (body && card.dataset.body !== body) show = false;
      if (year && card.dataset.year !== year) show = false;
      if (fuel && card.dataset.fuel !== fuel) show = false;

      if (price) {
        const [min, max] = price.split('-').map(Number);
        const p = Number(card.dataset.price);
        if (p < min || p > max) show = false;
      }

      if (mileage) {
        const [min, max] = mileage.split('-').map(Number);
        const m = Number(card.dataset.mileage);
        if (m < min || m > max) show = false;
      }

      card.style.display = show ? '' : 'none';
      if (show) visible++;
    });

    // Sort visible cards
    const sortedCards = cardsArray
      .filter(c => c.style.display !== 'none')
      .sort((a, b) => {
        switch (sort) {
          case 'price-low': return Number(a.dataset.price) - Number(b.dataset.price);
          case 'price-high': return Number(b.dataset.price) - Number(a.dataset.price);
          case 'year-new': return Number(b.dataset.year) - Number(a.dataset.year);
          case 'mileage-low': return Number(a.dataset.mileage) - Number(b.dataset.mileage);
          default: // featured
            const fa = a.dataset.featured === 'true' ? 1 : 0;
            const fb = b.dataset.featured === 'true' ? 1 : 0;
            return fb - fa;
        }
      });

    // Re-order DOM
    sortedCards.forEach(card => grid.appendChild(card));
    // Append hidden ones at end
    cardsArray.filter(c => c.style.display === 'none').forEach(c => grid.appendChild(c));

    resultCount.textContent = String(visible);
    noResults.classList.toggle('hidden', visible > 0);
    grid.classList.toggle('hidden', visible === 0);

    // Show/hide clear button
    const hasFilters = make || model || body || year || price || mileage || fuel;
    clearBtn.classList.toggle('hidden', !hasFilters);

    updateURL();
  }

  // Update model dropdown when make changes
  function updateModels() {
    const selectedMake = makeSelect.value;
    const map = (window as any).__makeModelsMap as Record<string, string[]>;

    // Save current model value
    const currentModel = modelSelect.value;

    // Clear existing options except "All Models"
    modelSelect.innerHTML = '<option value="">All Models</option>';

    if (selectedMake && map[selectedMake]) {
      map[selectedMake].sort().forEach(m => {
        const opt = document.createElement('option');
        opt.value = m;
        opt.textContent = m;
        modelSelect.appendChild(opt);
      });
      // Restore model if still valid
      if (map[selectedMake].includes(currentModel)) {
        modelSelect.value = currentModel;
      }
    } else {
      // Show all models
      const allModels = new Set<string>();
      Object.values(map).forEach(models => models.forEach(m => allModels.add(m)));
      Array.from(allModels).sort().forEach(m => {
        const opt = document.createElement('option');
        opt.value = m;
        opt.textContent = m;
        modelSelect.appendChild(opt);
      });
      if (allModels.has(currentModel)) {
        modelSelect.value = currentModel;
      }
    }
  }

  // Clear all filters
  function clearAll() {
    form.querySelectorAll('select').forEach(s => (s as HTMLSelectElement).value = '');
    sortSelect.value = 'featured';
    updateModels();
    applyFilters();
  }

  // Event listeners
  form.querySelectorAll('select').forEach(select => {
    select.addEventListener('change', () => {
      if (select === makeSelect) updateModels();
      applyFilters();
    });
  });

  sortSelect.addEventListener('change', applyFilters);
  clearBtn.addEventListener('click', clearAll);
  noResultsClear?.addEventListener('click', clearAll);

  // Mobile filter toggle
  mobileToggle?.addEventListener('click', () => {
    sidebar.classList.toggle('hidden');
    sidebar.classList.toggle('fixed');
    sidebar.classList.toggle('inset-0');
    sidebar.classList.toggle('z-50');
    sidebar.classList.toggle('bg-white');
    sidebar.classList.toggle('overflow-y-auto');
    sidebar.classList.toggle('p-6');
  });

  mobileApply?.addEventListener('click', () => {
    sidebar.classList.add('hidden');
    sidebar.classList.remove('fixed', 'inset-0', 'z-50', 'bg-white', 'overflow-y-auto', 'p-6');
  });

  // Init
  initFromURL();
  updateModels();
  applyFilters();
</script>

<style>
  @media (max-width: 1023px) {
    aside {
      display: none;
    }
    aside:not(.hidden) {
      display: block;
    }
  }
</style>
