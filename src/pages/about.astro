---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About Us - AutoDeal">
  <section class="bg-gradient-to-br from-[var(--color-dark)] to-gray-900 py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="text-[var(--color-primary)] text-sm font-semibold uppercase tracking-wider">About Us</span>
      <h1 class="text-4xl lg:text-5xl font-bold text-white mt-3 font-[family-name:var(--font-heading)]">Your Trusted Vehicle Export Partner</h1>
      <p class="text-gray-400 mt-4 max-w-2xl mx-auto text-lg">Quality vehicles from the UK, delivered worldwide with transparency and care.</p>
    </div>
  </section>

  <section class="py-16 lg:py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div>
          <h2 class="text-3xl font-bold text-gray-900 font-[family-name:var(--font-heading)]">Who We Are</h2>
          <p class="text-gray-600 mt-4 leading-relaxed">
            AutoDeal is a UK-based vehicle export company specializing in sourcing and shipping quality vehicles to customers worldwide. With years of experience in the automotive export industry, we've built a reputation for reliability, transparency, and exceptional service.
          </p>
          <p class="text-gray-600 mt-4 leading-relaxed">
            We handle everything from vehicle sourcing and inspection to shipping, customs clearance, and doorstep delivery. Our goal is to make the vehicle import process as smooth and stress-free as possible for our clients.
          </p>
        </div>
        <div class="bg-gray-100 rounded-2xl aspect-square flex items-center justify-center">
          <div class="text-center p-8">
            <svg class="w-16 h-16 text-gray-300 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
            <p class="text-gray-400 text-sm">About Image</p>
          </div>
        </div>
      </div>

      <!-- Values -->
      <div class="grid sm:grid-cols-3 gap-6 mt-16">
        <div class="bg-gray-50 rounded-2xl p-6 text-center">
          <div class="w-14 h-14 bg-[var(--color-primary)]/10 rounded-xl flex items-center justify-center mx-auto mb-4">
            <svg class="w-7 h-7 text-[var(--color-primary)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
          </div>
          <h3 class="font-semibold text-gray-900 font-[family-name:var(--font-heading)]">Trust & Quality</h3>
          <p class="text-sm text-gray-500 mt-2">Every vehicle is inspected and verified before listing.</p>
        </div>
        <div class="bg-gray-50 rounded-2xl p-6 text-center">
          <div class="w-14 h-14 bg-[var(--color-primary)]/10 rounded-xl flex items-center justify-center mx-auto mb-4">
            <svg class="w-7 h-7 text-[var(--color-primary)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <h3 class="font-semibold text-gray-900 font-[family-name:var(--font-heading)]">Global Reach</h3>
          <p class="text-sm text-gray-500 mt-2">Exporting to 50+ countries across all continents.</p>
        </div>
        <div class="bg-gray-50 rounded-2xl p-6 text-center">
          <div class="w-14 h-14 bg-[var(--color-primary)]/10 rounded-xl flex items-center justify-center mx-auto mb-4">
            <svg class="w-7 h-7 text-[var(--color-primary)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <h3 class="font-semibold text-gray-900 font-[family-name:var(--font-heading)]">Fair Pricing</h3>
          <p class="text-sm text-gray-500 mt-2">Transparent pricing with no hidden fees.</p>
        </div>
      </div>
    </div>
  </section>
</Layout>
