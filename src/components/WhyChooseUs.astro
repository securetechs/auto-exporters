---
const services = [
  {
    title: 'Browse Inventory',
    description: 'Search our wide range of quality vehicles ready for export worldwide.',
    icon: 'M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z',
    link: '/vehicles',
    linkText: 'Search inventory',
  },
  {
    title: 'Get An Offer',
    description: 'Get a personalised quote for your desired vehicle including shipping costs.',
    icon: 'M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2',
    link: '/contact',
    linkText: 'Get trade-in value',
  },
  {
    title: 'Apply For Financing',
    description: 'Flexible finance options available. Easy application process with quick approval.',
    icon: 'M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
    link: '/contact',
    linkText: 'Apply Now',
  },
  {
    title: 'Expert Service',
    description: 'Professional support from selection to delivery. We handle customs and logistics.',
    icon: 'M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z',
    link: '/contact',
    linkText: 'Schedule Service',
  },
];
---

<section class="py-16 lg:py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <span class="text-[var(--color-primary)] text-sm font-semibold uppercase tracking-wider">Our Services</span>
      <h2 class="text-3xl font-bold text-gray-900 mt-2 font-[family-name:var(--font-heading)]">What We Offer</h2>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {services.map(service => (
        <div class="service-card text-center p-8 bg-white border border-gray-100 rounded-2xl hover:border-[var(--color-primary)]/30 hover:shadow-lg transition-all group">
          <div class="w-16 h-16 bg-[var(--color-primary)]/10 rounded-full flex items-center justify-center mx-auto mb-5 group-hover:bg-[var(--color-primary)] transition-colors">
            <svg class="w-7 h-7 text-[var(--color-primary)] group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={service.icon} />
            </svg>
          </div>
          <h3 class="font-semibold text-gray-900 text-lg mb-2 font-[family-name:var(--font-heading)]">{service.title}</h3>
          <p class="text-sm text-gray-500 leading-relaxed mb-4">{service.description}</p>
          <a href={service.link} class="text-sm font-semibold text-[var(--color-primary)] hover:text-[var(--color-primary-dark)] transition-colors inline-flex items-center gap-1">
            {service.linkText}
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </a>
        </div>
      ))}
    </div>
  </div>
</section>
