---
const benefits = [
  {
    title: 'New range rover, defender, discovery',
    description: 'Experience the joy of owning a brand new Range Rover, Defender or Discovery today!',
    icon: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
  },
  {
    title: 'Pre-Owned vehicles',
    description: 'AutoDeal has a great selection of pre-owned vehicles.',
    icon: 'M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4',
  },
  {
    title: 'Certified pre-owned vehicles',
    description: 'AutoDeal has a great selection of certified pre-owned vehicles.',
    icon: 'M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z',
  },
  {
    title: 'Financing',
    description: 'Get approved today and drive off in a new or used vehicle.',
    icon: 'M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
  },
];
---

<section class="py-16 lg:py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <!-- Left: Mountain BG + sliding car -->
      <div class="relative rounded-2xl overflow-hidden aspect-[3/4]">
        <!-- Mountain background -->
        <img src="/assets/images/section/wcu-bg.webp" alt="Mountain landscape" class="w-full h-full object-cover absolute inset-0" loading="lazy" />

        <!-- Slowly sliding car -->
        <div class="absolute bottom-0 left-0 right-0 wcu-car-wrapper">
          <img src="/assets/images/section/wcu-car.webp" alt="Car" class="w-[85%] max-w-[420px] object-contain wcu-car" loading="lazy" />
        </div>

        <!-- Floating stat badges -->
        <div class="absolute right-[-20px] top-1/2 -translate-y-1/2 flex flex-col gap-3 z-10">
          <div class="bg-white rounded-xl shadow-lg px-5 py-3 flex items-center gap-3">
            <div class="w-9 h-9 bg-emerald-100 rounded-full flex items-center justify-center shrink-0">
              <svg class="w-5 h-5 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            </div>
            <span class="text-sm font-semibold text-gray-800">Proven Expertise</span>
          </div>
          <div class="bg-white rounded-xl shadow-lg px-5 py-3 flex items-center gap-3">
            <div class="w-9 h-9 bg-[var(--color-primary)]/10 rounded-full flex items-center justify-center shrink-0">
              <svg class="w-5 h-5 text-[var(--color-primary)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
            </div>
            <span class="text-sm font-semibold text-gray-800">1 million visits per day</span>
          </div>
          <div class="bg-white rounded-xl shadow-lg px-5 py-3 flex items-center gap-3">
            <div class="w-9 h-9 bg-[var(--color-primary)]/10 rounded-full flex items-center justify-center shrink-0">
              <svg class="w-5 h-5 text-[var(--color-primary)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
            </div>
            <span class="text-sm font-semibold text-gray-800">7,800 car sellers</span>
          </div>
        </div>
      </div>

      <!-- Right: Benefits -->
      <div class="pl-4">
        <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 mb-4 font-[family-name:var(--font-heading)]">Why Choose Auto Deal</h2>
        <p class="text-gray-500 text-sm mb-8 max-w-md">Our experienced team excels in car sales with many years of successfully navigating the market, delivering informed decisions and optimal results.</p>

        <div class="space-y-6">
          {benefits.map(benefit => (
            <div class="flex gap-4 group">
              <div class="w-12 h-12 bg-[var(--color-primary)]/10 rounded-xl flex items-center justify-center shrink-0 group-hover:bg-[var(--color-primary)] transition-colors">
                <svg class="w-6 h-6 text-[var(--color-primary)] group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={benefit.icon} />
                </svg>
              </div>
              <div>
                <h3 class="font-semibold text-gray-900 text-base font-[family-name:var(--font-heading)]">{benefit.title}</h3>
                <p class="text-sm text-gray-500 mt-1">{benefit.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes wcuCarSlide {
    0% { transform: translateX(-10%); }
    50% { transform: translateX(5%); }
    100% { transform: translateX(-10%); }
  }
  .wcu-car {
    animation: wcuCarSlide 12s ease-in-out infinite;
  }
</style>
