---
const features = [
  {
    title: 'Quality Inspected',
    description: 'Every vehicle undergoes a thorough multi-point inspection before listing. Only the best make it to our inventory.',
    icon: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
  },
  {
    title: 'Worldwide Shipping',
    description: 'We export to over 50 countries. From Africa to the Caribbean, Middle East to Asia — we deliver anywhere.',
    icon: 'M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
  },
  {
    title: 'Transparent Pricing',
    description: 'No hidden fees. What you see is what you pay. Full cost breakdown including shipping and customs clearance.',
    icon: 'M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
  },
  {
    title: 'Expert Support',
    description: 'Our dedicated team guides you through every step — from selection to customs clearance to doorstep delivery.',
    icon: 'M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z',
  },
];
---

<section class="py-16 lg:py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <span class="text-[var(--color-primary)] text-sm font-semibold uppercase tracking-wider">Why Us</span>
      <h2 class="text-3xl font-bold text-gray-900 mt-2 font-[family-name:var(--font-heading)]">Why Choose AutoDeal</h2>
      <p class="text-gray-500 mt-3 max-w-2xl mx-auto">We make vehicle export simple, transparent, and reliable. Here's what sets us apart.</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {features.map((feature, i) => (
        <div class="group p-6 bg-gray-50 hover:bg-[var(--color-primary)] rounded-2xl transition-all duration-300 cursor-default">
          <div class="w-14 h-14 bg-[var(--color-primary)]/10 group-hover:bg-white/20 rounded-xl flex items-center justify-center mb-5 transition-colors">
            <svg class="w-7 h-7 text-[var(--color-primary)] group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={feature.icon} />
            </svg>
          </div>
          <h3 class="font-semibold text-gray-900 group-hover:text-white text-lg mb-2 font-[family-name:var(--font-heading)] transition-colors">{feature.title}</h3>
          <p class="text-sm text-gray-500 group-hover:text-white/80 leading-relaxed transition-colors">{feature.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
