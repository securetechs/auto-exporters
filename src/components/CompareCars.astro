---
import { getCollection } from 'astro:content';

const allVehicles = await getCollection('vehicles');
const vehicles = allVehicles
  .filter(v => v.data.images && v.data.images.length > 0)
  .sort((a, b) => b.data.price - a.data.price)
  .slice(0, 4);

// Create pairs for comparison (2 cars per pair, 2 pairs total => 4 cars)
const pairs: (typeof vehicles)[] = [];
for (let i = 0; i < vehicles.length - 1; i += 2) {
  pairs.push([vehicles[i], vehicles[i + 1]]);
}

// Spec rows we'll render in the comparison table. Each row has a label
// and a function that extracts the value from a vehicle.
const specRows: { label: string; get: (d: any) => string }[] = [
  { label: 'Make',         get: d => d.make ?? '—' },
  { label: 'Model',        get: d => d.model ?? '—' },
  { label: 'Body',         get: d => d.bodyType ?? '—' },
  { label: 'Price',        get: d => d.price ? `$${d.price.toLocaleString()}` : '—' },
  { label: 'Condition',    get: d => d.condition ?? '—' },
  { label: 'Year',         get: d => d.year ? String(d.year) : '—' },
  { label: 'Transmission', get: d => d.transmission ?? '—' },
  { label: 'Drive Type',   get: d => d.driveType ?? '—' },
  { label: 'Engine Size',  get: d => d.engineSize ?? '—' },
  { label: 'Fuel Type',    get: d => d.fuel ?? '—' },
  { label: 'Doors',        get: d => d.doors ? String(d.doors) : '—' },
  { label: 'Color',        get: d => d.color ?? '—' },
  { label: 'Mileage',      get: d => d.mileage != null ? `${d.mileage.toLocaleString()} mi` : '—' },
];
---

<section class="py-16 lg:py-20 bg-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-10">
      <span class="text-[var(--color-primary)] text-sm font-semibold uppercase tracking-wider">Compare</span>
      <h2 class="text-3xl font-bold text-gray-900 mt-2 font-[family-name:var(--font-heading)]">
        Compare to buy the right car
      </h2>
    </div>

    <div class="grid lg:grid-cols-2 gap-6">
      {pairs.map(pair => (
        <div class="bg-white rounded-2xl border border-gray-100 overflow-hidden hover:shadow-lg transition-all">
          <!-- Top: two vehicle headers with VS -->
          <div class="grid grid-cols-2 relative">
            {pair.map(v => (
              <div class="p-5">
                <a href={`/vehicles/${v.data.slug}`} class="block aspect-[4/3] bg-gray-100 rounded-xl overflow-hidden mb-3 group">
                  <img
                    src={v.data.images![0]}
                    alt={v.data.title}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    loading="lazy"
                  />
                </a>
                <span class="text-xs text-[var(--color-primary)] font-medium uppercase tracking-wider">{v.data.make}</span>
                <h4 class="font-semibold text-sm text-gray-900 mt-1 font-[family-name:var(--font-heading)] leading-snug">
                  <a href={`/vehicles/${v.data.slug}`} class="hover:text-[var(--color-primary)] transition-colors">
                    {v.data.title}
                  </a>
                </h4>
                <p class="text-[var(--color-primary)] font-bold text-base mt-1.5 font-[family-name:var(--font-heading)]">
                  ${v.data.price.toLocaleString()}
                </p>
              </div>
            ))}
            <!-- VS badge centered between the two cards -->
            <span class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 bg-[var(--color-dark)] text-white text-[10px] font-bold w-8 h-8 rounded-full flex items-center justify-center shadow-md border-2 border-white">
              VS
            </span>
          </div>

          <!-- Spec comparison table -->
          <div class="border-t border-gray-100">
            <dl class="divide-y divide-gray-100">
              {specRows.map(row => (
                <div class="grid grid-cols-2 text-xs">
                  <div class="px-5 py-2.5 bg-gray-50/50 border-r border-gray-100 flex items-center justify-between gap-2">
                    <span class="text-gray-400 font-medium">{row.label}</span>
                    <span class="text-gray-800 font-semibold text-right truncate">{row.get(pair[0].data)}</span>
                  </div>
                  <div class="px-5 py-2.5 flex items-center justify-between gap-2">
                    <span class="text-gray-400 font-medium">{row.label}</span>
                    <span class="text-gray-800 font-semibold text-right truncate">{row.get(pair[1].data)}</span>
                  </div>
                </div>
              ))}
            </dl>
          </div>

          <!-- Footer: Compare button -->
          <div class="grid grid-cols-2 border-t border-gray-100">
            <a href={`/vehicles/${pair[0].data.slug}`} class="text-center py-3 text-xs font-semibold text-gray-600 hover:text-[var(--color-primary)] hover:bg-gray-50 transition-colors border-r border-gray-100">
              View {pair[0].data.make}
            </a>
            <a href={`/vehicles/${pair[1].data.slug}`} class="text-center py-3 text-xs font-semibold text-gray-600 hover:text-[var(--color-primary)] hover:bg-gray-50 transition-colors">
              View {pair[1].data.make}
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
