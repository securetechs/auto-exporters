---
const testimonials = [
  {
    name: 'Arlene McCoy',
    role: 'CEO',
    text: 'My experience with AutoDeal has exceeded expectations. Professional service from selection to delivery. The team handled everything including customs and shipping.',
    rating: 5,
  },
  {
    name: 'Antony Lam',
    role: 'Car Seller',
    text: 'Excellent platform for selling vehicles internationally. The process was smooth and transparent. I received my payment on time and the team was always available.',
    rating: 5,
  },
  {
    name: 'Anna Delrey',
    role: 'Sale Manager',
    text: 'AutoDeal made buying a car from overseas effortless. They guided me through every step and the vehicle arrived exactly as described. Highly recommended!',
    rating: 5,
  },
  {
    name: 'Harley Marley',
    role: 'Product Manager',
    text: 'The best car export service I have ever used. Their team is knowledgeable, responsive, and truly cares about customer satisfaction. Will use again.',
    rating: 5,
  },
];
---

<section class="py-16 lg:py-20 bg-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-10">
      <span class="text-[var(--color-primary)] text-sm font-semibold uppercase tracking-wider">Testimonials</span>
      <h2 class="text-3xl font-bold text-gray-900 mt-2 font-[family-name:var(--font-heading)]">We love our clients</h2>
    </div>

    <div class="swiper testimonial-swiper">
      <div class="swiper-wrapper">
        {testimonials.map(t => (
          <div class="swiper-slide">
            <div class="bg-white rounded-2xl p-8 border border-gray-100 shadow-sm text-center">
              <!-- Stars -->
              <div class="flex justify-center gap-1 mb-4">
                {Array.from({ length: t.rating }).map(() => (
                  <svg class="w-5 h-5 text-yellow-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                ))}
              </div>
              <p class="text-gray-600 text-sm leading-relaxed mb-6 italic">"{t.text}"</p>
              <div class="flex items-center justify-center gap-3">
                <div class="w-12 h-12 bg-[var(--color-primary)]/10 rounded-full flex items-center justify-center">
                  <span class="text-[var(--color-primary)] font-bold text-lg font-[family-name:var(--font-heading)]">{t.name.charAt(0)}</span>
                </div>
                <div class="text-left">
                  <h4 class="font-semibold text-gray-900 text-sm font-[family-name:var(--font-heading)]">{t.name}</h4>
                  <p class="text-xs text-gray-500">{t.role}</p>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
      <div class="swiper-pagination testimonial-pagination mt-8"></div>
    </div>
  </div>
</section>

<script>
  import Swiper from 'swiper';
  import { Autoplay, Pagination } from 'swiper/modules';
  import 'swiper/css';
  import 'swiper/css/pagination';

  new Swiper('.testimonial-swiper', {
    modules: [Autoplay, Pagination],
    slidesPerView: 1,
    spaceBetween: 24,
    loop: true,
    autoplay: { delay: 5000, disableOnInteraction: false },
    pagination: { el: '.testimonial-pagination', clickable: true },
    breakpoints: {
      640: { slidesPerView: 2 },
      1024: { slidesPerView: 3 },
    },
  });
</script>
