---
import { getCollection } from 'astro:content';
import VehicleCard from './VehicleCard.astro';

const allVehicles = await getCollection('vehicles');
const vehicles = allVehicles.sort((a, b) => b.data.price - a.data.price).slice(0, 4);

// Get unique body types from actual vehicles
const bodyTypes = ['All Cars', ...new Set(allVehicles.map(v => v.data.bodyType))];
---

<section class="pt-8 pb-16 lg:pt-10 lg:pb-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="flex items-center justify-between mb-8">
      <h2 class="text-lg sm:text-2xl lg:text-3xl font-bold text-gray-900 font-[family-name:var(--font-heading)]">Used Cars By Body Type</h2>
      <a href="/vehicles" class="text-[var(--color-primary)] hover:text-[var(--color-primary-dark)] font-semibold text-sm flex items-center gap-1 transition-colors">
        View all
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      </a>
    </div>

    <!-- Tabs -->
    <div class="flex flex-wrap gap-2 mb-8" id="body-type-tabs">
      {bodyTypes.map((type, i) => (
        <button
          class={`tab-btn text-sm ${i === 0 ? 'active' : ''}`}
          data-body-type={type}
        >
          {type}
        </button>
      ))}
    </div>

    <!-- Mobile: vertical cards, single column -->
    <div class="grid grid-cols-1 gap-4 md:hidden" id="body-type-grid">
      {vehicles.map(vehicle => (
        <div class="vehicle-item" data-body={vehicle.data.bodyType}>
          <VehicleCard
            slug={vehicle.data.slug}
            title={vehicle.data.title}
            price={vehicle.data.price}
            mileage={vehicle.data.mileage}
            fuel={vehicle.data.fuel}
            transmission={vehicle.data.transmission}
            bodyType={vehicle.data.bodyType}
            year={vehicle.data.year}
            images={vehicle.data.images}
            featured={vehicle.data.featured}
            condition={vehicle.data.condition}
            layout="vertical"
          />
        </div>
      ))}
    </div>

    <!-- Desktop: horizontal cards, 2 columns -->
    <div class="hidden md:grid md:grid-cols-2 gap-6" id="body-type-grid-desktop">
      {vehicles.map(vehicle => (
        <div class="vehicle-item" data-body={vehicle.data.bodyType}>
          <VehicleCard
            slug={vehicle.data.slug}
            title={vehicle.data.title}
            price={vehicle.data.price}
            mileage={vehicle.data.mileage}
            fuel={vehicle.data.fuel}
            transmission={vehicle.data.transmission}
            bodyType={vehicle.data.bodyType}
            year={vehicle.data.year}
            images={vehicle.data.images}
            featured={vehicle.data.featured}
            condition={vehicle.data.condition}
            layout="horizontal"
          />
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  const tabs = document.querySelectorAll('#body-type-tabs .tab-btn');
  const items = document.querySelectorAll('.vehicle-item');

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      tabs.forEach(t => t.classList.remove('active'));
      tab.classList.add('active');
      const type = (tab as HTMLElement).dataset.bodyType;

      items.forEach(item => {
        const el = item as HTMLElement;
        if (type === 'All Cars' || el.dataset.body === type) {
          el.style.display = '';
        } else {
          el.style.display = 'none';
        }
      });
    });
  });
</script>
