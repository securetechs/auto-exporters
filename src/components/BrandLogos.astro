---
import { getCollection } from 'astro:content';

const allVehicles = await getCollection('vehicles');

// Auto-generate brand list from actual vehicles
const makeCounts = new Map<string, number>();
allVehicles.forEach(v => {
  const make = v.data.make;
  makeCounts.set(make, (makeCounts.get(make) || 0) + 1);
});

const brandLogos: Record<string, string> = {
  'Toyota': '<path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 2c1.85 0 3.55.63 4.9 1.69C15.55 7.54 13.86 9 12 9s-3.55-1.46-4.9-3.31A7.96 7.96 0 0112 4zm0 16c-4.41 0-8-3.59-8-8 0-1.85.63-3.55 1.69-4.9C7.54 8.45 9.63 10 12 10s4.46-1.55 6.31-2.9A7.96 7.96 0 0120 12c0 4.41-3.59 8-8 8z"/>',
  'BMW': '<path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 1.5c4.69 0 8.5 3.81 8.5 8.5s-3.81 8.5-8.5 8.5S3.5 16.69 3.5 12 7.31 3.5 12 3.5zM12 4v8h8c0-4.42-3.58-8-8-8zm0 8H4c0 4.42 3.58 8 8 8v-8z"/>',
  'Mercedes-Benz': '<path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm0-14l-1.5 6.5L4 15l8 2 8-2-6.5-2.5z"/>',
  'Audi': '<path d="M2 12a4 4 0 108 0 4 4 0 00-8 0zm5.5 0a4 4 0 108 0 4 4 0 00-8 0zm5.5 0a4 4 0 108 0 4 4 0 00-8 0zm5.5 0a4 4 0 108 0 4 4 0 00-8 0z"/>',
  'Ford': '<rect x="2" y="6" width="20" height="12" rx="3"/><text x="12" y="15" text-anchor="middle" fill="white" font-size="8" font-weight="bold" font-family="serif">Ford</text>',
  'Nissan': '<path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 3c3.87 0 7 3.13 7 7h-4.5L12 8.5 9.5 12H5c0-3.87 3.13-7 7-7zm0 14c-3.87 0-7-3.13-7-7h4.5l2.5 3.5 2.5-3.5H19c0 3.87-3.13 7-7 7z"/>',
  'Land Rover': '<rect x="1" y="7" width="22" height="10" rx="2"/><text x="12" y="14" text-anchor="middle" fill="white" font-size="5" font-weight="bold" font-family="sans-serif">LAND ROVER</text>',
  'McLaren': '<path d="M2 16c0-4 2-8 5-10s4-2 5-2 2 0 5 2 5 6 5 10H2zm3-1h14c-1-3-2.5-6-4.5-7.5C13.5 6.5 13 6.5 12 6.5s-1.5 0-2.5 1C7.5 9 6 12 5 15z"/>',
  'Porsche': '<path d="M4 6h16v2H4zm-1 3h18v8H3V9zm2 2v4h14v-4H5zm3 1h8v2H8z"/>',
  'Rolls Royce': '<path d="M12 2L8 6H4v4l-4 2 4 2v4h4l4 4 4-4h4v-4l4-2-4-2V6h-4L12 2zm0 4l2 2h3v3l2 1-2 1v3h-3l-2 2-2-2H7v-3l-2-1 2-1V8h3l2-2z"/>',
  'Kia': '<rect x="2" y="7" width="20" height="10" rx="3"/><text x="12" y="15" text-anchor="middle" fill="white" font-size="9" font-weight="bold" font-family="sans-serif">KIA</text>',
};

const brands = Array.from(makeCounts.entries())
  .sort((a, b) => b[1] - a[1])
  .map(([name, count]) => ({ name, count, logo: brandLogos[name] || '' }));
---

<section class="py-14 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-10">
      <span class="text-[var(--color-primary)] text-sm font-semibold uppercase tracking-wider">Browse By</span>
      <h2 class="text-3xl font-bold text-gray-900 mt-2 font-[family-name:var(--font-heading)]">Popular Car Makes & Body Types</h2>
    </div>
    <div class="swiper brand-swiper">
      <div class="swiper-wrapper">
        {brands.map(brand => (
          <div class="swiper-slide">
            <a href={`/vehicles?make=${brand.name}`} class="flex flex-col items-center p-5 rounded-xl border border-gray-100 hover:border-[var(--color-primary)] hover:shadow-md transition-all group">
              <div class="w-20 h-20 bg-gray-50 group-hover:bg-[var(--color-primary)]/5 rounded-2xl flex items-center justify-center mb-3 transition-colors">
                {brand.logo ? (
                  <svg class="w-10 h-10 text-gray-600 group-hover:text-[var(--color-primary)] transition-colors" fill="currentColor" viewBox="0 0 24 24" set:html={brand.logo} />
                ) : (
                  <span class="text-2xl font-bold text-gray-400 group-hover:text-[var(--color-primary)] transition-colors font-[family-name:var(--font-heading)]">
                    {brand.name[0]}
                  </span>
                )}
              </div>
              <span class="text-sm font-semibold text-gray-800 font-[family-name:var(--font-heading)]">{brand.name}</span>
              <span class="text-xs text-gray-400 mt-1">{brand.count} Car{brand.count !== 1 ? 's' : ''}</span>
            </a>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  import Swiper from 'swiper';
  import { Autoplay } from 'swiper/modules';
  import 'swiper/css';

  new Swiper('.brand-swiper', {
    modules: [Autoplay],
    slidesPerView: 2,
    spaceBetween: 16,
    loop: true,
    autoplay: { delay: 3000, disableOnInteraction: false },
    breakpoints: {
      480: { slidesPerView: 3 },
      640: { slidesPerView: 4 },
      768: { slidesPerView: 5 },
      1024: { slidesPerView: 6 },
      1280: { slidesPerView: 7 },
    },
  });
</script>
