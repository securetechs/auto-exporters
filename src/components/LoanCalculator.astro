---
interface Props {
  defaultPrice?: number;
}

const { defaultPrice = 30000 } = Astro.props;
---

<section class="py-16 lg:py-20 bg-gray-50" id="loan-calculator">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-10">
      <span class="text-[var(--color-primary)] text-sm font-semibold uppercase tracking-wider">Financial Tools</span>
      <h2 class="text-3xl font-bold text-gray-900 mt-2 font-[family-name:var(--font-heading)]">Auto Loan Calculator</h2>
    </div>

    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
      <div class="grid lg:grid-cols-2">
        <!-- Form -->
        <div class="p-8 lg:p-10">
          <div class="space-y-5">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1.5">Total Price ($)</label>
              <input type="number" id="calc-price" value={defaultPrice} min="0" class="w-full bg-gray-50 border border-gray-200 rounded-lg px-4 py-3 text-sm focus:ring-2 focus:ring-[var(--color-primary)]/20 focus:border-[var(--color-primary)] outline-none transition-all" />
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1.5">Down Payment ($)</label>
              <input type="number" id="calc-down" value="5000" min="0" class="w-full bg-gray-50 border border-gray-200 rounded-lg px-4 py-3 text-sm focus:ring-2 focus:ring-[var(--color-primary)]/20 focus:border-[var(--color-primary)] outline-none transition-all" />
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1.5">Loan Term</label>
              <select id="calc-term" class="filter-select w-full bg-gray-50 border border-gray-200 rounded-lg px-4 py-3 text-sm focus:ring-2 focus:ring-[var(--color-primary)]/20 focus:border-[var(--color-primary)] outline-none transition-all">
                <option value="12">12 Months</option>
                <option value="24">24 Months</option>
                <option value="36" selected>36 Months</option>
                <option value="48">48 Months</option>
                <option value="60">60 Months</option>
                <option value="72">72 Months</option>
              </select>
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1.5">Interest Rate (%)</label>
              <input type="number" id="calc-rate" value="5.5" min="0" max="30" step="0.1" class="w-full bg-gray-50 border border-gray-200 rounded-lg px-4 py-3 text-sm focus:ring-2 focus:ring-[var(--color-primary)]/20 focus:border-[var(--color-primary)] outline-none transition-all" />
            </div>
            <button id="calc-btn" type="button" class="w-full bg-[var(--color-primary)] hover:bg-[var(--color-primary-dark)] text-white py-3 rounded-lg font-semibold transition-all text-sm">
              Calculate
            </button>
          </div>
        </div>

        <!-- Results -->
        <div class="bg-[var(--color-dark)] p-8 lg:p-10 flex flex-col justify-center">
          <h3 class="text-white font-semibold text-lg mb-6 font-[family-name:var(--font-heading)]">Payment Summary</h3>
          <div class="space-y-4">
            <div class="flex justify-between items-center pb-4 border-b border-white/10">
              <span class="text-gray-400 text-sm">Down Payment</span>
              <span class="text-white font-semibold" id="result-down">$5,000</span>
            </div>
            <div class="flex justify-between items-center pb-4 border-b border-white/10">
              <span class="text-gray-400 text-sm">Amount Financed</span>
              <span class="text-white font-semibold" id="result-financed">$25,000</span>
            </div>
            <div class="flex justify-between items-center pb-4 border-b border-white/10">
              <span class="text-gray-400 text-sm">Total Interest</span>
              <span class="text-white font-semibold" id="result-interest">$2,178</span>
            </div>
            <div class="flex justify-between items-center pt-2">
              <span class="text-white font-semibold">Monthly Payment</span>
              <span class="text-3xl font-bold text-[var(--color-primary)] font-[family-name:var(--font-heading)]" id="result-monthly">$755</span>
            </div>
          </div>
          <a href="/contact" class="mt-8 block text-center bg-[var(--color-primary)] hover:bg-[var(--color-primary-dark)] text-white py-3 rounded-lg font-semibold transition-all text-sm">
            Apply for a Loan
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function calculate() {
    const price = parseFloat((document.getElementById('calc-price') as HTMLInputElement).value) || 0;
    const down = parseFloat((document.getElementById('calc-down') as HTMLInputElement).value) || 0;
    const term = parseInt((document.getElementById('calc-term') as HTMLSelectElement).value) || 36;
    const rate = parseFloat((document.getElementById('calc-rate') as HTMLInputElement).value) || 0;

    const financed = Math.max(0, price - down);
    const monthlyRate = rate / 100 / 12;
    let monthly = 0;
    let totalInterest = 0;

    if (monthlyRate > 0 && term > 0) {
      monthly = financed * (monthlyRate * Math.pow(1 + monthlyRate, term)) / (Math.pow(1 + monthlyRate, term) - 1);
      totalInterest = (monthly * term) - financed;
    } else if (term > 0) {
      monthly = financed / term;
    }

    const fmt = (n: number) => '$' + Math.round(n).toLocaleString();
    document.getElementById('result-down')!.textContent = fmt(down);
    document.getElementById('result-financed')!.textContent = fmt(financed);
    document.getElementById('result-interest')!.textContent = fmt(totalInterest);
    document.getElementById('result-monthly')!.textContent = fmt(monthly);
  }

  document.getElementById('calc-btn')?.addEventListener('click', calculate);
  // Calculate on load
  calculate();
</script>
