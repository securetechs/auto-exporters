---
const vehicles = [
  { title: 'Toyota Land Cruiser', year: 2023, price: 45000, mileage: '12,500', fuel: 'Diesel', transmission: 'Automatic', body: 'SUV', image: null },
  { title: 'BMW X5 xDrive', year: 2022, price: 52000, mileage: '18,200', fuel: 'Petrol', transmission: 'Automatic', body: 'SUV', image: null },
  { title: 'Mercedes-Benz C-Class', year: 2023, price: 38000, mileage: '8,400', fuel: 'Diesel', transmission: 'Automatic', body: 'Sedan', image: null },
  { title: 'Ford Ranger Wildtrak', year: 2022, price: 32000, mileage: '22,100', fuel: 'Diesel', transmission: 'Automatic', body: 'Pickup Truck', image: null },
  { title: 'Nissan Patrol', year: 2023, price: 48000, mileage: '5,800', fuel: 'Petrol', transmission: 'Automatic', body: 'SUV', image: null },
  { title: 'Audi Q7 S-Line', year: 2022, price: 55000, mileage: '15,300', fuel: 'Diesel', transmission: 'Automatic', body: 'SUV', image: null },
];
---

<section class="py-16 lg:py-20 bg-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-10">
      <div>
        <span class="text-[var(--color-primary)] text-sm font-semibold uppercase tracking-wider">Our Inventory</span>
        <h2 class="text-3xl font-bold text-gray-900 mt-2 font-[family-name:var(--font-heading)]">Featured Vehicles</h2>
      </div>
      <a href="/vehicles" class="text-[var(--color-primary)] hover:text-[var(--color-primary-dark)] font-semibold text-sm flex items-center gap-1 transition-colors">
        View All Vehicles
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      </a>
    </div>

    <!-- Vehicle Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {vehicles.map(vehicle => (
        <a href="/vehicles" class="group bg-white rounded-2xl border border-gray-100 overflow-hidden hover:shadow-lg hover:border-[var(--color-primary)]/20 transition-all duration-300">
          <!-- Image -->
          <div class="relative aspect-[16/10] bg-gray-100 overflow-hidden">
            <div class="absolute inset-0 flex items-center justify-center bg-gradient-to-br from-gray-100 to-gray-200">
              <svg class="w-16 h-16 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
            </div>
            <!-- Body Type Badge -->
            <span class="absolute top-3 left-3 bg-[var(--color-primary)] text-white text-xs font-semibold px-3 py-1 rounded-full">
              {vehicle.body}
            </span>
          </div>

          <!-- Content -->
          <div class="p-5">
            <h3 class="font-semibold text-gray-900 group-hover:text-[var(--color-primary)] transition-colors font-[family-name:var(--font-heading)] text-lg">
              {vehicle.title}
            </h3>
            <div class="text-2xl font-bold text-[var(--color-primary)] mt-2 font-[family-name:var(--font-heading)]">
              ${vehicle.price.toLocaleString()}
            </div>

            <!-- Specs -->
            <div class="grid grid-cols-3 gap-3 mt-4 pt-4 border-t border-gray-100">
              <div class="flex items-center gap-1.5 text-gray-500">
                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                <span class="text-xs truncate">{vehicle.mileage} mi</span>
              </div>
              <div class="flex items-center gap-1.5 text-gray-500">
                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 18.657A8 8 0 016.343 7.343S7 9 9 10c0-2 .5-5 2.986-7C14 5 16.09 5.777 17.656 7.343A7.975 7.975 0 0120 13a7.975 7.975 0 01-2.343 5.657z"/></svg>
                <span class="text-xs truncate">{vehicle.fuel}</span>
              </div>
              <div class="flex items-center gap-1.5 text-gray-500">
                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                <span class="text-xs truncate">{vehicle.transmission}</span>
              </div>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
