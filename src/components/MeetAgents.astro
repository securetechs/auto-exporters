---
const agents = [
  { name: 'Ronal Son', role: 'Seller Staff', image: '/assets/images/section/bg-5.jpg' },
  { name: 'Lanna Sio', role: 'Administrative Staff', image: '/assets/images/section/bg-6.jpg' },
  { name: 'Jones Stonie', role: 'Manager', image: '/assets/images/section/bg-7.jpg' },
  { name: 'James Rome', role: 'Manager', image: '/assets/images/section/bg-8.jpg' },
];
---

<section class="py-16 lg:py-20 bg-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-10">
      <div>
        <span class="text-[var(--color-primary)] text-sm font-semibold uppercase tracking-wider">Our Team</span>
        <h2 class="text-3xl font-bold text-gray-900 mt-2 font-[family-name:var(--font-heading)]">Meet Our Agents</h2>
      </div>
      <p class="text-sm text-gray-500 max-w-md">Become an agent and get the commission you deserve. <a href="/contact" class="text-[var(--color-primary)] font-semibold hover:underline">Contact us</a></p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {agents.map(agent => (
        <div class="bg-white rounded-2xl overflow-hidden border border-gray-100 hover:shadow-lg transition-all group">
          <div class="aspect-[3/4] bg-gray-100 overflow-hidden">
            <img src={agent.image} alt={agent.name} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
          </div>
          <div class="p-5 text-center">
            <h3 class="font-semibold text-gray-900 font-[family-name:var(--font-heading)]">{agent.name}</h3>
            <p class="text-sm text-gray-500 mt-1">{agent.role}</p>
            <div class="flex justify-center gap-3 mt-3">
              <a href="#" class="w-8 h-8 bg-gray-100 hover:bg-[var(--color-primary)] hover:text-white rounded-full flex items-center justify-center text-gray-400 transition-all" aria-label="Phone">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              </a>
              <a href="#" class="w-8 h-8 bg-gray-100 hover:bg-[var(--color-primary)] hover:text-white rounded-full flex items-center justify-center text-gray-400 transition-all" aria-label="Email">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
