<section class="py-16 lg:py-20 relative overflow-hidden">
  <div class="absolute inset-0">
    <img src="/assets/images/section/bg-1.jpg" alt="" class="w-full h-full object-cover" />
    <div class="absolute inset-0 bg-[var(--color-dark)]/90"></div>
  </div>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="max-w-2xl mx-auto text-center">
      <h2 class="text-3xl lg:text-4xl font-bold text-white font-[family-name:var(--font-heading)] mb-4">
        Are you looking for a car?
