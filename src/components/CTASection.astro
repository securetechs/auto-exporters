---
---

<section class="py-16 lg:py-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid md:grid-cols-2 gap-6">
      <!-- Left: Looking for a car? (Orange) -->
      <div class="relative bg-[var(--color-primary)] rounded-2xl overflow-hidden p-8 lg:p-10 flex flex-col justify-center min-h-[240px]">
        <div class="absolute top-0 right-0 w-40 h-40 bg-white/10 rounded-full -translate-y-1/2 translate-x-1/3"></div>
        <div class="absolute bottom-0 left-0 w-24 h-24 bg-white/5 rounded-full translate-y-1/2 -translate-x-1/3"></div>
        <div class="relative">
          <h3 class="text-2xl lg:text-3xl font-bold text-white font-[family-name:var(--font-heading)] mb-3">
            Are you looking for a car?
          </h3>
          <p class="text-white/80 mb-6 text-sm leading-relaxed">
            Browse our extensive inventory of quality vehicles ready for export to your country.
          </p>
          <a href="/vehicles" class="inline-flex items-center gap-2 bg-white text-[var(--color-primary)] px-6 py-3 rounded-lg font-semibold text-sm hover:bg-gray-100 transition-colors">
            Search Cars
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </a>
        </div>
      </div>

      <!-- Right: Ready to export? (Dark) -->
      <div class="relative bg-[var(--color-dark)] rounded-2xl overflow-hidden p-8 lg:p-10 flex flex-col justify-center min-h-[240px]">
        <div class="absolute top-0 right-0 w-40 h-40 bg-white/5 rounded-full -translate-y-1/2 translate-x-1/3"></div>
        <div class="absolute bottom-0 left-0 w-24 h-24 bg-[var(--color-primary)]/10 rounded-full translate-y-1/2 -translate-x-1/3"></div>
        <div class="relative">
          <h3 class="text-2xl lg:text-3xl font-bold text-white font-[family-name:var(--font-heading)] mb-3">
            Ready to Export?
          </h3>
          <p class="text-gray-400 mb-6 text-sm leading-relaxed">
            Get a personalised quote including vehicle price, shipping, and customs clearance.
          </p>
          <a href="/contact" class="inline-flex items-center gap-2 bg-[var(--color-primary)] hover:bg-[var(--color-primary-dark)] text-white px-6 py-3 rounded-lg font-semibold text-sm transition-colors">
            Get Quote
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
