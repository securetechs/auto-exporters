---
---

<section class="py-16 lg:py-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid md:grid-cols-2 gap-6">
      <!-- Left: Download App (Dark) -->
      <div class="relative bg-[var(--color-dark)] rounded-2xl overflow-hidden p-8 lg:p-10 flex flex-col justify-center min-h-[280px]">
        <div class="absolute top-0 right-0 w-48 h-48 bg-white/5 rounded-full -translate-y-1/3 translate-x-1/3"></div>
        <div class="absolute bottom-0 left-0 w-32 h-32 bg-white/5 rounded-full translate-y-1/2 -translate-x-1/3"></div>
        <div class="relative">
          <h3 class="text-2xl lg:text-3xl font-bold text-white font-[family-name:var(--font-heading)] mb-3">
            Download our app
          </h3>
          <p class="text-gray-400 mb-6 text-sm leading-relaxed max-w-sm">
            Whether you're buying, selling, or simply researching cars, AutoDeal is the app for you.
          </p>
          <div class="flex gap-3">
            <a href="#" class="inline-flex items-center gap-2 bg-white/10 hover:bg-white/20 text-white px-5 py-2.5 rounded-lg text-sm font-medium transition-all border border-white/20">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M3 20.5v-17c0-.83.67-1.5 1.5-1.5.31 0 .6.1.83.27L18.5 12l-13.17 9.73c-.23.17-.52.27-.83.27-.83 0-1.5-.67-1.5-1.5z"/></svg>
              Google Play
            </a>
            <a href="#" class="inline-flex items-center gap-2 bg-white/10 hover:bg-white/20 text-white px-5 py-2.5 rounded-lg text-sm font-medium transition-all border border-white/20">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/></svg>
              App Store
            </a>
          </div>
        </div>
      </div>

      <!-- Right: Looking for a car? (Orange) -->
      <div class="relative bg-[var(--color-primary)] rounded-2xl overflow-hidden p-8 lg:p-10 flex flex-col justify-center min-h-[280px]">
        <div class="absolute top-0 right-0 w-48 h-48 bg-white/10 rounded-full -translate-y-1/3 translate-x-1/3"></div>
        <div class="absolute bottom-0 left-0 w-32 h-32 bg-white/5 rounded-full translate-y-1/2 -translate-x-1/3"></div>
        <div class="relative">
          <h3 class="text-2xl lg:text-3xl font-bold text-white font-[family-name:var(--font-heading)] mb-3">
            Are you looking for a car?
          </h3>
          <p class="text-white/80 mb-6 text-sm leading-relaxed max-w-sm">
            Save time and effort as you no longer need to visit multiple stores to find the right car.
          </p>
          <a href="/vehicles" class="inline-flex items-center gap-2 bg-white text-[var(--color-primary)] px-6 py-3 rounded-lg font-semibold text-sm hover:bg-gray-100 transition-colors">
            Find cars
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
