---
---

<section class="py-16 lg:py-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="relative bg-gradient-to-br from-[var(--color-dark)] to-gray-900 rounded-3xl overflow-hidden">
      <!-- Background Decoration -->
      <div class="absolute top-0 right-0 w-80 h-80 bg-[var(--color-primary)]/10 rounded-full -translate-y-1/2 translate-x-1/3 blur-3xl"></div>
      <div class="absolute bottom-0 left-0 w-60 h-60 bg-[var(--color-primary)]/5 rounded-full translate-y-1/2 -translate-x-1/3 blur-3xl"></div>

      <div class="relative grid lg:grid-cols-2 gap-8 items-center p-8 md:p-12 lg:p-16">
        <!-- Text -->
        <div>
          <h2 class="text-3xl lg:text-4xl font-bold text-white font-[family-name:var(--font-heading)] leading-tight">
            Ready to Find Your
            <span class="text-[var(--color-primary)]"> Perfect Vehicle?</span>
          </h2>
          <p class="text-gray-400 mt-4 text-lg leading-relaxed">
            Browse our inventory or get in touch for a personalised quote. We'll help you find exactly what you need and handle the entire export process.
          </p>
          <div class="flex flex-wrap gap-4 mt-8">
            <a href="/vehicles" class="bg-[var(--color-primary)] hover:bg-[var(--color-primary-dark)] text-white px-8 py-3.5 rounded-full font-semibold transition-all hover:shadow-lg hover:shadow-[var(--color-primary)]/25 text-sm">
              Browse Inventory
            </a>
            <a href="/contact" class="border border-white/20 hover:border-white/40 text-white px-8 py-3.5 rounded-full font-semibold transition-all text-sm">
              Contact Us
            </a>
          </div>
        </div>

        <!-- Stats Card -->
        <div class="bg-white/5 backdrop-blur-sm border border-white/10 rounded-2xl p-8">
          <div class="grid grid-cols-2 gap-6">
            <div class="text-center p-4">
              <div class="text-3xl font-bold text-[var(--color-primary)] font-[family-name:var(--font-heading)]">500+</div>
              <div class="text-sm text-gray-400 mt-1">Cars Exported</div>
            </div>
            <div class="text-center p-4">
              <div class="text-3xl font-bold text-[var(--color-primary)] font-[family-name:var(--font-heading)]">50+</div>
              <div class="text-sm text-gray-400 mt-1">Countries</div>
            </div>
            <div class="text-center p-4">
              <div class="text-3xl font-bold text-[var(--color-primary)] font-[family-name:var(--font-heading)]">98%</div>
              <div class="text-sm text-gray-400 mt-1">Satisfaction</div>
            </div>
            <div class="text-center p-4">
              <div class="text-3xl font-bold text-[var(--color-primary)] font-[family-name:var(--font-heading)]">24/7</div>
              <div class="text-sm text-gray-400 mt-1">Support</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
