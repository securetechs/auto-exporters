---
import { getCollection } from 'astro:content';

const allVehicles = await getCollection('vehicles');
const featured = allVehicles
  .filter(v => v.data.featured && v.data.images && v.data.images.length > 0)
  .sort((a, b) => b.data.price - a.data.price)
  .slice(0, 4);
---

<section class="relative bg-[var(--color-dark)] overflow-hidden">
  <div class="swiper hero-swiper w-full" style="height: 600px;">
    <div class="swiper-wrapper">
      {featured.map((vehicle, i) => (
        <div class="swiper-slide relative">
          <!-- Background Image -->
          <div class="absolute inset-0">
            <img
              src={vehicle.data.images![0]}
              alt={vehicle.data.title}
              class="w-full h-full object-cover"
            />
            <div class="absolute inset-0 bg-gradient-to-r from-black/70 via-black/40 to-transparent"></div>
          </div>

          <!-- Content Overlay -->
          <div class="relative h-full flex items-center">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
              <div class="max-w-xl">
                <div class="flex items-center gap-3 mb-4">
                  <span class="bg-[var(--color-primary)] text-white text-xs font-semibold px-3 py-1 rounded">
                    {vehicle.data.condition || 'Used'}
                  </span>
                  <span class="text-white/70 text-sm">
                    {vehicle.data.mileage.toLocaleString()} mi
                  </span>
                </div>
                <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white font-[family-name:var(--font-heading)] leading-tight mb-4">
                  {vehicle.data.title}
                </h2>
                <div class="flex items-center gap-4 mb-6">
                  <span class="text-2xl font-bold text-[var(--color-primary)] font-[family-name:var(--font-heading)]">
                    ${vehicle.data.price.toLocaleString()}
                  </span>
                  <span class="text-white/50 text-sm">|</span>
                  <span class="text-white/70 text-sm">{vehicle.data.fuel} &bull; {vehicle.data.transmission}</span>
                </div>
                <a
                  href={`/vehicles/${vehicle.data.slug}`}
                  class="inline-flex items-center gap-2 bg-[var(--color-primary)] hover:bg-[var(--color-primary-dark)] text-white px-8 py-3.5 rounded-lg font-semibold transition-all text-sm"
                >
                  View Details
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                </a>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
    <div class="swiper-pagination !bottom-6"></div>
    <div class="swiper-button-prev !left-4 !w-11 !h-11"></div>
    <div class="swiper-button-next !right-4 !w-11 !h-11"></div>
  </div>
</section>

<script>
  import Swiper from 'swiper';
  import { Navigation, Pagination, Autoplay } from 'swiper/modules';
  import 'swiper/css';
  import 'swiper/css/navigation';
  import 'swiper/css/pagination';

  new Swiper('.hero-swiper', {
    modules: [Navigation, Pagination, Autoplay],
    loop: true,
    autoplay: { delay: 5000, disableOnInteraction: false },
    pagination: { el: '.swiper-pagination', clickable: true },
    navigation: { nextEl: '.swiper-button-next', prevEl: '.swiper-button-prev' },
    speed: 600,
  });
</script>
