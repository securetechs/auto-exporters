---
import { getCollection } from 'astro:content';

const allVehicles = await getCollection('vehicles');
const featured = allVehicles
  .filter(v => v.data.featured && v.data.images && v.data.images.length > 0)
  .sort((a, b) => b.data.price - a.data.price)
  .slice(0, 4);

const totalVehicles = allVehicles.length;

const makes = ['Make', 'Audi', 'BMW', 'Ford', 'Land Rover', 'McLaren', 'Mercedes-Benz', 'Nissan', 'Porsche', 'Rolls Royce', 'Toyota'];
const bodyTypes = ['Body Type', 'Sedan', 'SUV', 'Hatchback', 'Coupe', 'Pickup Truck', 'Crossover', 'Minivan', 'Convertible'];
const doors = ['Door', '2', '3', '4', '5'];
const models = ['Model', 'All Models'];
const fuelTypes = ['Fuel Type', 'Petrol', 'Diesel', 'Electric', 'Hybrid'];
const transmissions = ['Transmission', 'Automatic', 'Manual', 'CVT'];
---

<section class="relative bg-[var(--color-dark)] overflow-hidden">
  <!-- Background Carousel -->
  <div class="swiper hero-swiper w-full" style="height: 720px;">
    <div class="swiper-wrapper">
      {featured.map(vehicle => (
        <div class="swiper-slide relative">
          <div class="absolute inset-0">
            <img
              src={vehicle.data.images![0]}
              alt={vehicle.data.title}
              class="w-full h-full object-cover"
            />
            <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/55 to-black/30"></div>
          </div>
        </div>
      ))}
    </div>
    <div class="swiper-button-prev hero-prev !left-auto !right-16 !top-auto !bottom-[300px] !w-10 !h-10 after:!text-base"></div>
    <div class="swiper-button-next hero-next !right-4 !top-auto !bottom-[300px] !w-10 !h-10 after:!text-base"></div>
  </div>

  <!-- Overlay Content -->
  <div class="absolute inset-0 z-10 flex flex-col justify-center">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
      <!-- Heading -->
      <div class="mb-8">
        <p class="text-[var(--color-primary)] text-sm font-medium mb-2">Over {totalVehicles.toLocaleString()} classified ads listing</p>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white font-[family-name:var(--font-heading)] leading-tight hero-heading">
          Find what are you<br />looking for
        </h1>
        <p class="text-white/50 text-sm mt-3 max-w-lg">
          Explore the worlds largest database to buy, sell, trade or simply rent a car
        </p>
      </div>

      <!-- Search Bar with Tabs -->
      <div class="bg-white rounded-xl shadow-xl max-w-5xl overflow-hidden">
        <!-- Tabs - flat text style like demo -->
        <div class="flex border-b border-gray-100" id="hero-tabs">
          <button class="hero-tab active px-6 py-3.5 text-sm font-semibold text-[var(--color-primary)] border-b-2 border-[var(--color-primary)] transition-all" data-tab="all">All</button>
          <button class="hero-tab px-6 py-3.5 text-sm font-semibold text-gray-500 hover:text-[var(--color-primary)] border-b-2 border-transparent transition-all" data-tab="new">New Car</button>
          <button class="hero-tab px-6 py-3.5 text-sm font-semibold text-gray-500 hover:text-[var(--color-primary)] border-b-2 border-transparent transition-all" data-tab="used">Used Car</button>
        </div>

        <!-- Search Fields -->
        <form action="/vehicles" method="get" class="p-4 lg:p-5">
          <input type="hidden" name="condition" id="hero-condition" value="" />
          <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
            <select name="make" class="bg-gray-50 border border-gray-200 rounded-lg px-3 py-2.5 text-sm text-gray-700 outline-none focus:border-[var(--color-primary)] transition-colors">
              {makes.map(m => <option value={m === 'Make' ? '' : m}>{m}</option>)}
            </select>
            <select name="model" class="bg-gray-50 border border-gray-200 rounded-lg px-3 py-2.5 text-sm text-gray-700 outline-none focus:border-[var(--color-primary)] transition-colors">
              {models.map(m => <option value={m === 'Model' ? '' : m}>{m}</option>)}
            </select>
            <select name="doors" class="bg-gray-50 border border-gray-200 rounded-lg px-3 py-2.5 text-sm text-gray-700 outline-none focus:border-[var(--color-primary)] transition-colors">
              {doors.map(d => <option value={d === 'Door' ? '' : d}>{d}</option>)}
            </select>
            <select name="body" class="bg-gray-50 border border-gray-200 rounded-lg px-3 py-2.5 text-sm text-gray-700 outline-none focus:border-[var(--color-primary)] transition-colors">
              {bodyTypes.map(b => <option value={b === 'Body Type' ? '' : b}>{b}</option>)}
            </select>
            <select name="fuel" class="bg-gray-50 border border-gray-200 rounded-lg px-3 py-2.5 text-sm text-gray-700 outline-none focus:border-[var(--color-primary)] transition-colors">
              {fuelTypes.map(f => <option value={f === 'Fuel Type' ? '' : f}>{f}</option>)}
            </select>
            <select name="transmission" class="bg-gray-50 border border-gray-200 rounded-lg px-3 py-2.5 text-sm text-gray-700 outline-none focus:border-[var(--color-primary)] transition-colors">
              {transmissions.map(t => <option value={t === 'Transmission' ? '' : t}>{t}</option>)}
            </select>
          </div>
          <div class="mt-4 flex justify-end">
            <button type="submit" class="bg-[var(--color-primary)] hover:bg-[var(--color-primary-dark)] text-white px-8 py-2.5 rounded-lg font-semibold transition-all flex items-center gap-2 text-sm">
              Find cars
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
            </button>
          </div>
        </form>
      </div>

      <!-- Body Type Quick Links -->
      <div class="flex flex-wrap gap-5 mt-5">
        <a href="/vehicles?bodyType=Coupe" class="inline-flex items-center gap-2 text-sm text-white/60 hover:text-white transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 17h8M6 17H4v-2l2-4h2l2-3h4l2 3h2l2 4v2h-2"/></svg>
          Coupe
        </a>
        <a href="/vehicles?bodyType=SUV" class="inline-flex items-center gap-2 text-sm text-white/60 hover:text-white transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 17h8M6 17H4v-2l2-4h2l2-3h4l2 3h2l2 4v2h-2"/></svg>
          SUV
        </a>
        <a href="/vehicles?bodyType=Sedan" class="inline-flex items-center gap-2 text-sm text-white/60 hover:text-white transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 17h8M6 17H4v-2l2-4h2l2-3h4l2 3h2l2 4v2h-2"/></svg>
          Sedan
        </a>
        <a href="/vehicles?bodyType=Hatchback" class="inline-flex items-center gap-2 text-sm text-white/60 hover:text-white transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 17h8M6 17H4v-2l2-4h2l2-3h4l2 3h2l2 4v2h-2"/></svg>
          Hatchback
        </a>
        <a href="/vehicles?bodyType=Pickup+Truck" class="inline-flex items-center gap-2 text-sm text-white/60 hover:text-white transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 17h8M6 17H4v-2l2-4h2l2-3h4l2 3h2l2 4v2h-2"/></svg>
          Pickup Truck
        </a>
        <a href="/vehicles?bodyType=Minivan" class="inline-flex items-center gap-2 text-sm text-white/60 hover:text-white transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 17h8M6 17H4v-2l2-4h2l2-3h4l2 3h2l2 4v2h-2"/></svg>
          Minivan
        </a>
        <a href="/vehicles?bodyType=Crossover" class="inline-flex items-center gap-2 text-sm text-white/60 hover:text-white transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 17h8M6 17H4v-2l2-4h2l2-3h4l2 3h2l2 4v2h-2"/></svg>
          Crossover
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  import Swiper from 'swiper';
  import { Navigation, Autoplay, EffectFade } from 'swiper/modules';
  import 'swiper/css';
  import 'swiper/css/navigation';
  import 'swiper/css/effect-fade';

  const heroHeadings = [
    'Find what are you<br />looking for',
    "Let's find your next drive<br />in your city",
  ];

  new Swiper('.hero-swiper', {
    modules: [Navigation, Autoplay, EffectFade],
    loop: true,
    effect: 'fade',
    autoplay: { delay: 5000, disableOnInteraction: false },
    navigation: { nextEl: '.hero-next', prevEl: '.hero-prev' },
    speed: 800,
    on: {
      slideChange: function () {
        const heading = document.querySelector('.hero-heading');
        if (heading) {
          const idx = this.realIndex % heroHeadings.length;
          heading.innerHTML = heroHeadings[idx];
        }
      },
    },
  });

  // Hero tabs - flat text style
  const heroTabs = document.querySelectorAll<HTMLButtonElement>('.hero-tab');
  const condInput = document.getElementById('hero-condition') as HTMLInputElement;

  heroTabs.forEach(tab => {
    tab.addEventListener('click', () => {
      heroTabs.forEach(t => {
        t.classList.remove('active', 'text-[var(--color-primary)]', 'border-[var(--color-primary)]');
        t.classList.add('text-gray-500', 'border-transparent');
      });
      tab.classList.add('active', 'text-[var(--color-primary)]', 'border-[var(--color-primary)]');
      tab.classList.remove('text-gray-500', 'border-transparent');

      const val = tab.dataset.tab;
      if (condInput) {
        condInput.value = val === 'new' ? 'New' : val === 'used' ? 'Used' : '';
      }
    });
  });
</script>
