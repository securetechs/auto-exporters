---
---

<section class="relative bg-gradient-to-br from-[var(--color-dark)] via-gray-900 to-[var(--color-dark)] overflow-hidden">
  <!-- Background Pattern -->
  <div class="absolute inset-0 opacity-5">
    <div class="absolute top-20 left-10 w-72 h-72 bg-[var(--color-primary)] rounded-full blur-3xl"></div>
    <div class="absolute bottom-20 right-10 w-96 h-96 bg-[var(--color-primary)] rounded-full blur-3xl"></div>
  </div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <!-- Text -->
      <div>
        <span class="inline-block bg-[var(--color-primary)]/10 text-[var(--color-primary)] text-sm font-semibold px-4 py-1.5 rounded-full mb-6 border border-[var(--color-primary)]/20">
          Trusted UK Vehicle Export
        </span>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-white leading-tight font-[family-name:var(--font-heading)] mb-6">
          Find Your Next
          <span class="text-[var(--color-primary)]"> Drive</span>
          <br />For Export
        </h1>
        <p class="text-lg text-gray-400 mb-8 max-w-lg">
          Quality vehicles from the UK, exported worldwide. Browse our inventory, find the perfect car, and we handle the rest.
        </p>
        <div class="flex flex-wrap gap-4">
          <a href="/vehicles" class="bg-[var(--color-primary)] hover:bg-[var(--color-primary-dark)] text-white px-8 py-3.5 rounded-full font-semibold transition-all hover:shadow-lg hover:shadow-[var(--color-primary)]/25 text-sm">
            Browse Vehicles
          </a>
          <a href="/contact" class="border border-white/20 hover:border-white/40 text-white px-8 py-3.5 rounded-full font-semibold transition-all text-sm">
            Get a Quote
          </a>
        </div>

        <!-- Stats -->
        <div class="flex gap-10 mt-12 pt-8 border-t border-white/10">
          <div>
            <div class="text-3xl font-bold text-white font-[family-name:var(--font-heading)]">500+</div>
            <div class="text-sm text-gray-500 mt-1">Vehicles Exported</div>
          </div>
          <div>
            <div class="text-3xl font-bold text-white font-[family-name:var(--font-heading)]">50+</div>
            <div class="text-sm text-gray-500 mt-1">Countries Served</div>
          </div>
          <div>
            <div class="text-3xl font-bold text-white font-[family-name:var(--font-heading)]">98%</div>
            <div class="text-sm text-gray-500 mt-1">Client Satisfaction</div>
          </div>
        </div>
      </div>

      <!-- Hero Image Placeholder -->
      <div class="hidden lg:block relative">
        <div class="relative bg-gradient-to-br from-gray-800 to-gray-900 rounded-2xl overflow-hidden aspect-[4/3] border border-white/5">
          <div class="absolute inset-0 flex items-center justify-center">
            <div class="text-center">
              <svg class="w-20 h-20 text-gray-700 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M19 9l-7 7-7-7" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M8 17h8M6 21h12a2 2 0 002-2v-5a2 2 0 00-2-2H6a2 2 0 00-2 2v5a2 2 0 002 2z" />
              </svg>
              <p class="text-gray-600 text-sm">Hero Image</p>
              <p class="text-gray-700 text-xs mt-1">Replace with vehicle photo</p>
            </div>
          </div>
          <!-- Decorative Elements -->
          <div class="absolute -bottom-6 -right-6 w-32 h-32 bg-[var(--color-primary)]/20 rounded-full blur-2xl"></div>
          <div class="absolute -top-6 -left-6 w-24 h-24 bg-[var(--color-primary)]/10 rounded-full blur-2xl"></div>
        </div>
      </div>
    </div>
  </div>
</section>
